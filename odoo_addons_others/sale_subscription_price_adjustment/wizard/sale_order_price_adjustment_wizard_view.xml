<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <data>

        <record model="ir.ui.view" id="sale_order_price_adjustment_form">
            <field name="name">Sale order price adjustment form</field>
            <field name="model">sale.order.price.adjustment.wizard</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <field name="date_adjustment"/>
                        <field name="adjustment_percentage"/>
                        <field name="end_date_adjustment"/>
                    </group>
                    <footer>
                        <button string="Actualizar precios" type="object" name="adjust_price" class="oe_highlight"/>
                        o
                        <button class="oe_link" special="cancel" string="Salir"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="sale_order_price_adjustment_view" model="ir.actions.act_window">
            <field name="name">Ajustar precios</field>
            <field name="res_model">sale.order.price.adjustment.wizard</field>
            <field name="view_mode">form</field>
            <field name="binding_model_id" ref="sale.model_sale_order"/>
            <field name="binding_view_types">form,list</field>
            <field name="target">new</field>
        </record>

    </data>
</odoo>

