<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <data>

        <record model="ir.ui.view" id="res_company_perceptions_form">
            <field name="name">Res company perceptions form</field>
            <field name="model">res.company</field>
            <field name="inherit_id" ref="base.view_company_form"/>
            <field name="arch" type="xml">
                <notebook position="inside">
                    <page string="Percepciones">
                        <field name="perception_ids" nolabel="1">
                            <tree editable="bottom">
                                <field name="company_id" column_invisible="True"/>
                                <field name="perception_id" domain="['|',('company_id', '=', parent.id),('company_id', '=', False)]"/>
                                <field name="type"/>
                                <field name="state_id"/>
                            </tree>
                        </field>
                    </page>
                </notebook>
            </field>
        </record>

    </data>

</odoo>

