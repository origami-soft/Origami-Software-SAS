<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <data>

        <record model="ir.ui.view" id="res_partner_perceptions_form">
            <field name="name">Res partner perception forms</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="base.view_partner_form"/>
            <field name="arch" type="xml">
                <notebook position="inside">
                    <page string="Percepciones" groups="account.group_account_invoice"
                          invisible="parent_id">
                        <field name="perception_partner_rule_ids" nolabel="1">
                            <tree editable="bottom">
                                <field name="partner_id" column_invisible="True"/>
                                <field name="date_from" readonly="1"/>
                                <field name="date_to" readonly="1"/>
                                <field name="perception_id" domain="['|',('company_id', '=', parent.company_id),('company_id', '=', False)]"/>
                                <field name="date_from" optional="hide"/>
                                <field name="date_to" optional="hide"/>
                                <field name="type"/>
                                <field name="state_id"/>
                                <field name="percentage"/>
                                <field name="exception_date"/>
                                <field name="company_id" column_invisible="True"/>
                            </tree>
                        </field>
                    </page>
                </notebook>
            </field>
        </record>

    </data>

</odoo>

