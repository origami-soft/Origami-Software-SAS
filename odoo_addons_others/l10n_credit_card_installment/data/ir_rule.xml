<?xml version="1.0" encoding="utf-8"?>

<odoo noupdate="1">

    <record model="ir.rule" id="credit_card_installment_multi">
        <field name="name">Credit card installment: multi-company</field>
        <field name="model_id" ref="model_credit_card_installment"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|',('company_id', 'in', company_ids),('company_id','=',False)]</field>
    </record>

</odoo>

