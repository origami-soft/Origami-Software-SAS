<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record model="ir.ui.view" id="credit_card_installment_concile_form">
            <field name="name">Credit card installment concile form</field>
            <field name="model">credit.card.installment.concile</field>
            <field name="arch" type="xml">
                <form delete="false">
                    <header>
                        <button name="post" type="object" string="Validar" invisible="state != 'draft'" groups="l10n_treasury.group_account_treasury_manager"/>
                        <button name="cancel" type="object" string="Anular Conciliación" confirm="Está seguro?" invisible="state not in ['reconciled', 'draft']" groups="l10n_treasury.group_account_treasury_manager"/>
                        <button name="cancel_to_draft" type="object" string="Volver a borrador" invisible="state != 'canceled'" groups="l10n_treasury.group_account_treasury_manager"/>
                        <field name="state" widget="statusbar" nolabel="1" statusbar_visible="draft,reconciled"/>
                    </header>
                    <sheet>
                        <field name="currency_id" invisible="1"/>
                        <h2><field name="name"/></h2>
                        <group>
                            <group>
                                <field name="date" readonly="state != 'draft'"/>
                                <field name="company_id" groups="base.group_multi_company"/>
                                <field name="date_from"/>
                                <field
                                    name="move_id"
                                    readonly="state != 'reconciled'"
                                    groups="account.group_account_user"
                                />
                                <field
                                    name="journal_id"
                                    domain="[('type', '=', 'bank')]"
                                    context="{'form_view_ref': 'account.view_account_bank_journal_form'}"
                                    readonly="state != 'draft'"
                                />
                            </group>
                            <group>
                                <field name="credit_card_id"/>
                                <field name="date_to"/>
                                <field name="amount"/>
                            </group>
                        </group>
                        <separator string="Cuotas"/>
                        <field name="installment_ids" options="{'no_create': True}"
                               readonly="state != 'draft'"
                               domain="[('concile_ids', '=', False), ('reconciled', '=', False), ('credit_card_id', '=', credit_card_id)]"
                        >
                            <tree editable="bottom">
                                <field name="currency_id" invisible="1"/>
                                <field name="credit_card_id" readonly="1"/>
                                <field name="name"/>
                                <field name="due_date"/>
                                <field name="installments_text"/>
                                <field name="amount"/>
                                <field name="reconciled"/>
                            </tree>
                        </field>
                    </sheet>
                </form>
            </field>
        </record>

        <record model="ir.ui.view" id="credit_card_installment_concile_tree">
            <field name="name">Credit card installment concile Tree</field>
            <field name="model">credit.card.installment.concile</field>
            <field name="arch" type="xml">
                <tree>
                    <field name="name"/>
                    <field name="credit_card_id"/>
                    <field name="date"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                </tree>
            </field>
        </record>

        <record id="credit_card_installment_concile_action" model="ir.actions.act_window">
            <field name="name">Conciliaciones</field>
            <field name="res_model">credit.card.installment.concile</field>
            <field name="view_mode">tree,form</field>
        </record>

        <menuitem
            id="credit_card_installment_concile_menu"
            name="Conciliaciones"
            action="credit_card_installment_concile_action"
            parent="l10n_credit_cards.credit_card_main_menu"
            sequence="30"
        />

    </data>
</odoo>

