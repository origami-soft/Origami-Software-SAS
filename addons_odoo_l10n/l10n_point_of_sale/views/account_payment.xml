<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <data>
   
        <record model="ir.ui.view" id="l10n_point_of_sale_payment_form">
            <field name="name">l10n point of sale payment form</field>
            <field name="model">account.payment</field>
            <field name="inherit_id" ref="account.view_account_payment_form"/>
            <field name="arch" type="xml">
                <field name="name" position="before">
                    <field name="full_voucher_name" 
                           readonly="1"/>
                </field>
                <field name="name" position="attributes">
                    <attribute name="invisible">1</attribute>
                </field>
                <field name="journal_id" position="after">
                    <field name="pos_document_book_ids" invisible="1"/>
                    <field
                        name="pos_ar_id"
                        invisible="is_internal_transfer"
                        readonly="1"
                    />
                    <field name="company_id" invisible="1"/>
                    <field name="document_book_type" invisible="1"/>
                    <field name="document_book_id"
                           invisible="not pos_ar_id or is_internal_transfer"
                           readonly="state != 'draft'"
                           domain="[('id', 'in', pos_document_book_ids)]"/>
                </field>
            </field>
        </record>

        <record model="ir.ui.view" id="l10n_point_of_sale_payment_tree">
            <field name="name">l10n point of sale payment tree</field>
            <field name="model">account.payment</field>
            <field name="inherit_id" ref="account.view_account_payment_tree"/>
            <field name="arch" type="xml">
                <field name="name" position="before">
                    <field name="full_voucher_name"/>
                </field>
                <field name="name" position="attributes">
                    <attribute name="column_invisible">1</attribute>
                </field>
            </field>
        </record>

    </data>
</odoo>

