<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <data>

        <record model="ir.ui.view" id="invoice_pos_ar_form">
            <field name="name">Invoice pos ar form</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <field name="ref" position="after">
                    <field name="pos_document_book_ids" invisible="1"/>
                    <field name="document_book_id"
                           invisible="not pos_ar_id"
                           readonly="state != 'draft'"
                           domain="[('id', 'in', pos_document_book_ids)]"/>
                    <field name="document_book_type" invisible="1"/>
                </field>
                <div name="journal_div" position="after">
                     <field
                        name="pos_ar_id"
                        invisible="move_type not in ['out_invoice', 'out_refund']"
                        readonly="True"
                    />
                </div>
                <!-- NO SE PUEDE CAMBIAR DIARIO DESDE EL USUARIO DE FACTURACION POR LO CUAL NO PODRIAN CAMBIAR EL PUNTO
                DE VENTA UN USUARIO DE FACTURACION, EL PERMISO ORIGINAL ES ACCOUNT.GROUP_ACCOUNT_USER -->
                <label for="journal_id" position="attributes">
                    <attribute name="groups">account.group_account_invoice</attribute>
                </label>
                <div name="journal_div" position="attributes">
                    <attribute name="groups">account.group_account_invoice</attribute>
                </div>
            </field>
        </record>

    </data>
</odoo>

