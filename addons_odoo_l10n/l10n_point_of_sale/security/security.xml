<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <data noupdate="1">

        <record model="ir.rule" id="document_book_multi">
            <field name="name">Document book: multi-company</field>
            <field name="model_id" ref="model_document_book"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|',('company_id','in', company_ids),('company_id','=',False)]</field>
        </record>

        <record model="ir.rule" id="pos_ar_multi">
            <field name="name">Pos ar: multi-company</field>
            <field name="model_id" ref="model_pos_ar"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|',('company_id','in', company_ids),('company_id','=',False)]</field>
        </record>

    </data>
</odoo>

