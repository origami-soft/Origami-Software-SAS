<?xml version="1.0" encoding="utf-8"?>

<openerp>
    <data>

        <record model="ir.ui.view" id="payment_imputation_wizard_form">
            <field name="name">Payment imputation form</field>
            <field name="model">payment.imputation.wizard</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <group>
                                <field name="payment_type" invisible="1"/>
                                <field name="operation_type" widget="radio"/>
                                <field name="partner_id" required="1" context="{'res_partner_search_mode': payment_type != 'inbound' and 'supplier' or 'customer'}"/>
                                <field name="amount_to_pay" invisible="payment_type != 'inbound' or operation_type != 'payment'" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            </group>
                            <group>
                                <field name="date"/>
                                <field name="currency_id" string="Moneda" invisible="operation_type == 'payment'" required="operation_type != 'payment'"/>
                                <field name="journal_id" string="Diario" invisible="operation_type != 'payment'" required="operation_type == 'payment'"/>
                            </group>
                        </group>
                        <separator string="Débitos"/>
                        <label for="select_all_debit" string="Seleccionar todos" class="btn btn-secondary"/>
                        <field name="select_all_debit" class="d-none"/>
                        <field name="debit_imputation_line_ids" widget="one2many">
                            <tree
                                editable="bottom" create="false"
                                decoration-info="amount &gt; 0 and amount &lt; amount_residual_in_payment_currency"
                                decoration-muted="amount == 0"
                                decoration-success="amount == amount_residual_in_payment_currency"
                                decoration-danger="amount &gt; amount_residual_in_payment_currency"
                            >
                                <field name="concile" string="Imputar total" optional="show"/>
                                <field name="name" optional="show"/>
                                <field name="move_line_date" optional="show"/>
                                <field name="move_line_date_maturity" optional="show"/>
                                <field name="move_line_id" column_invisible="1"/>
                                <field name="currency_id" column_invisible="1"/>
                                <field name="company_currency_id" column_invisible="1"/>
                                <field name="payment_currency_id" column_invisible="1"/>
                                <field name="amount" optional="show"/>
                                <field name="amount_residual_in_payment_currency" string="Restante" optional="show"/>
                                <field name="amount_total_in_payment_currency" string="Total" optional="show"/>
                                <field name="full_reconcile" string="Conciliar diferencia" optional="show"/>
                            </tree>
                        </field>
                        <separator string="Créditos"/>
                        <label for="select_all_credit" string="Seleccionar todos" class="btn btn-secondary"/>
                        <field name="select_all_credit" class="d-none"/>
                        <field name="credit_imputation_line_ids">
                            <tree
                                editable="bottom" create="false"
                                decoration-info="amount &gt; 0 and amount &lt; amount_residual_in_payment_currency"
                                decoration-muted="amount == 0"
                                decoration-success="amount == amount_residual_in_payment_currency"
                                decoration-danger="amount &gt; amount_residual_in_payment_currency"
                            >
                                <field name="concile" string="Imputar total" optional="show"/>
                                <field name="name" optional="show"/>
                                <field name="move_line_date" optional="show"/>
                                <field name="move_line_id" column_invisible="1"/>
                                <field name="currency_id" column_invisible="1"/>
                                <field name="company_currency_id" column_invisible="1"/>
                                <field name="payment_currency_id" column_invisible="1"/>
                                <field name="amount" optional="show"/>
                                <field name="amount_residual_in_payment_currency" string="Restante" optional="show"/>
                                <field name="amount_total_in_payment_currency" string="Total" optional="show"/>
                                <field name="full_reconcile" string="Conciliar diferencia" optional="show"/>
                            </tree>
                        </field>
                        <group>
                            <field name="advance_amount" widget="monetary" options="{'currency_field': 'currency_id'}" invisible="operation_type != 'payment'"/>
                            <field name="total" widget="monetary" options="{'currency_field': 'currency_id'}" invisible="operation_type != 'payment'"/>
                            <field name="amount_left" invisible="payment_type != 'inbound' or operation_type != 'payment'" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                        </group>
                        <footer>
                            <button
                                name="create_payment"
                                string="Crear pago"
                                type="object"
                                class="btn btn-primary"
                                invisible="operation_type != 'payment'"
                            />
                            <button
                                name="create_payment"
                                string="Crear conciliación"
                                type="object"
                                class="btn btn-primary"
                                invisible="operation_type == 'payment'"
                            />
                            <button string="Cancelar" class="oe_link" special="cancel"/>
                        </footer>
                    </sheet>
                </form>
            </field>
        </record>

    </data>
</openerp>

