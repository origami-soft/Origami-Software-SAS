<?xml version="1.0" encoding="utf-8"?>

<openerp>
    <data>

        <record model="ir.ui.view" id="payment_imputation_form">
            <field name="name">Payment imputation form</field>
            <field name="model">account.payment</field>
            <field name="inherit_id" ref="account.view_account_payment_form"/>
            <field name="priority">20</field>
            <field name="arch" type="xml">
                <form position="attributes">
                    <attribute name="create">0</attribute>
                </form>
                <div name="amount_div" position="after">
                    <field name="payment_imputation_difference" invisible="is_internal_transfer"/>
                </div>
                <group name="group2" position="inside">
                    <field name="payment_difference" invisible="1"/>
                    <div name="payment_difference" invisible="not payment_difference" groups="account.group_account_user">
                        <label for="payment_difference" string="Diferencia"/>
                        <field name="payment_difference"/>
                        <field name="payment_difference_handling" widget="radio" nolabel="1"/>
                        <div invisible="payment_difference_handling == 'open'">
                            <label for="writeoff_account_id" string="Contabilizar la diferencia en" class="oe_edit_only"/>
                            <field name="writeoff_account_id"
                                   options="{'no_create': True}"
                                   required="payment_difference_handling == 'reconcile'"
                            />
                            <label for="writeoff_label" class="oe_edit_only" string="Descripción"/>
                            <field name="writeoff_label" required="payment_difference_handling == 'reconcile'"/>
                        </div>
                    </div>
                </group>
                <group position="after">
                    <notebook invisible="is_internal_transfer">
                        <page string="Documentos a imputar">
                            <field name="payment_imputation_ids" colspan="2" readonly="state != 'draft'" nolabel="1">
                                <tree editable="bottom" create="false" decoration-info="amount &gt; 0 and amount &lt; amount_residual_in_payment_currency and payment_state =='draft'" decoration-muted="amount == 0 and payment_state =='draft'" decoration-success="amount == amount_residual_in_payment_currency and payment_state =='draft'" decoration-danger="amount &gt; amount_residual_in_payment_currency and payment_state =='draft'">
                                    <field name="concile" string="Imputar total"/>
                                    <field name="name"/>
                                    <field name="move_line_date"/>
                                    <field name="move_line_date_maturity"/>
                                    <field name="move_line_id" column_invisible="1"/>
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="company_currency_id" column_invisible="1"/>
                                    <field name="payment_currency_id" column_invisible="1"/>
                                    <field name="payment_state" column_invisible="1"/>
                                    <field name="amount" sum="Total"/>
                                    <field name="amount_residual_in_payment_currency" string="Restante"/>
                                    <field name="amount_total_in_payment_currency" string="Total"/>
                                    <field name="full_reconcile" string="Conciliacion completa"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Documentos imputados">
                            <field name="payment_imputation_move_ids" colspan="2" readonly="1" nolabel="1">
                                <tree editable="bottom" create="false">
                                    <field name="move_id"/>
                                    <field name="invoice_date"/>
                                    <field name="invoice_date_due"/>
                                    <field name="amount" sum="Total"/>
                                    <field name="amount_residual"/>
                                    <field name="amount_total" sum="Total"/>
                                    <field name="currency_id" invisible="1"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                    <group>
                        <field
                            name="advance_amount"
                            readonly="state != 'draft'"
                            invisible="is_internal_transfer"
                        />
                    </group>
                </group>

            </field>
        </record>

    </data>
</openerp>

