<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <!-- VISTA TREE -->
    <record id="account_deposit_slip_tree" model="ir.ui.view">
        <field name="name">account.deposit.slip.tree</field>
        <field name="model">account.deposit.slip</field>
        <field name="arch" type="xml">
            <tree
                string="Boleta de depósito"
                delete="false"
                decoration-info="state=='draft'"
                decoration-muted="state=='canceled'"
                decoration-success="state=='deposited'"
            >
                <field name="name"/>
                <field name="reference"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="date"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <!-- VISTA FORM -->
    <record id="account_deposit_slip_form" model="ir.ui.view">
        <field name="name">account.deposit.slip.form</field>
        <field name="model">account.deposit.slip</field>
        <field name="arch" type="xml">
            <form string="Boleta de depósito" delete="false">
                <header>
                    <button name="post" type="object" string="Validar" invisible="state != 'draft'" groups="l10n_treasury.group_account_treasury_manager"/>
                    <button name="cancel_deposit_slip" type="object" string="Anular" confirm="¿Está seguro?" invisible="state not in ['deposited','draft']" groups="l10n_treasury.group_account_treasury_manager"/>
                    <button name="cancel_to_draft" type="object" string="Volver a borrador" invisible="state != 'canceled'" groups="l10n_treasury.group_account_treasury_manager"/>
                    <field name="state" widget="statusbar" nolabel="1" statusbar_visible="draft,deposited"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="view_moves" type="object" string="Asientos" icon="fa-pencil-square-o"
                        invisible="state != 'deposited'"/>
                    </div>
                    <h1>
                        <field name="name" class="oe_inline"/>
                    </h1>
                    <group>
                        <group>
                            <field name="reference" readonly="state != 'draft'"/>
                            <field name="date" readonly="state != 'draft'"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="journal_id" domain="[('type', '=', 'bank')]"
                                    context="{'form_view_ref': 'account.view_account_bank_journal_form'}"
                                    readonly="state != 'draft'"
                            />
                        </group>
                    </group>
                    <newline/>
                    <group string="Cheques">
                        <field name="check_ids" options="{'no_create': True}" nolabel="1"
                               readonly="state != 'draft'" colspan="2"
                               domain="[('state', '=', 'wallet'), ('deposit_slip_id', '=', False)]">
                            <tree>
                                <field name="currency_id" column_invisible="1"/>
                                <field name="name"/>
                                <field name="payment_id"/>
                                <field name="bank_id"/>
                                <field name="amount" sum='Total'/>
                                <field name="state"/>
                            </tree>
                        </field>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread" options="{&quot;thread_level&quot;: 1}"/>
                </div>
            </form>

        </field>
    </record>

    <!-- ACCIÓN  -->
    <record id="account_deposit_slip_action" model="ir.actions.act_window">
        <field name="name">Boletas de depósito</field>
        <field name="res_model">account.deposit.slip</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- BÚSQUEDAS Y AGRUPACIONES-->
    <record model="ir.ui.view" id="account_deposit_slip_search" >
        <field name="name">commission.collector.search</field>
        <field name="model">account.deposit.slip</field>
        <field name="arch" type="xml">
            <search string="Boletas de depósito">
                <field name="name" string="Name"/>
                <field name="reference" string="Referencia"/>
            </search>
        </field>
    </record>

    <!-- MENÚ  -->
    <menuitem
        id="account_deposit_slip_menu"
        action="account_deposit_slip_action"
        name="Boletas de depósito"
        parent="l10n_account_check.treasury_third_checks_main_menu"
        sequence="20"
    />

</odoo>

