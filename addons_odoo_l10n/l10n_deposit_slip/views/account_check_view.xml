<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <record model="ir.ui.view" id="account_third_check_deposit_slip_form">
        <field name="name">Account third check deposit slip form</field>
        <field name="model">account.third.check</field>
        <field name="inherit_id" ref="l10n_account_check.account_third_check_form"/>
        <field name="arch" type="xml">
            <field name="check_type" position="after">
                <field name="deposit_slip_id" invisible="not deposit_slip_id"/>
            </field>
            <field name="payment_date" position="after">
                <field name="deposit_date" invisible="not deposit_slip_id"/>
                <field name="deposit_bank_id" invisible="not deposit_slip_id"/>
            </field>
        </field>
    </record>

</odoo>

