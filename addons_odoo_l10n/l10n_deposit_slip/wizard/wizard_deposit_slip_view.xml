<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <record model="ir.ui.view" id="account_deposit_slip_wizard_form">
        <field name="name">account.deposit.slip.wizard.form</field>
        <field name="model">wizard.deposit.slip</field>
        <field name="arch" type="xml">
            <form string="Check Deposit">
                <field name="valid_deposit" invisible="1"/>
                <group invisible="not valid_deposit">
                    <group>
                        <field name="journal_id" widget="selection"/>
                        <field name="total" readonly="1"/>
                    </group>
                    <group>
                        <field name="date"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                </group>
                <p invisible="valid_deposit">
                    Los cheques a depositar deben estar en cartera.
                </p>
                <footer>
                    <button type="object" name="action_create_deposit_slip" string="Depositar" class="oe_highlight"
                            invisible="not valid_deposit"/>
                    <button class="oe_link" special="cancel" string="Cancelar"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_check_deposit" model="ir.actions.act_window">
        <field name="name">Depositar cheques</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">wizard.deposit.slip</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="account_deposit_slip_wizard_form"/>
        <field name="binding_model_id" ref="model_account_third_check"/>
        <field name="binding_view_types">list,form</field>
        <field name="groups_id" eval="[(4, ref('l10n_treasury.group_account_treasury_manager'))]"/>
        <field name="target">new</field>
    </record>

</odoo>

