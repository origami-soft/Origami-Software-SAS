<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <record model="ir.ui.view" id="third_check_reject_form">
        <field name="name">Third check reject form</field>
        <field name="model">account.third.check</field>
        <field name="inherit_id" ref="l10n_account_check.account_third_check_form"/>
        <field name="arch" type="xml">
            <header position="inside">
                <button name="button_reject_check"
                        type="object" string="Rechazar"
                        confirm="¿Está seguro?"
                        invisible="state not in ['deposited', 'wallet', 'handed', 'sold']"
                        groups="l10n_treasury.group_account_treasury_manager"
                />
                <button name="button_revert_reject"
                        type="object"
                        string="Revertir rechazo"
                        invisible="state != 'rejected'"
                        groups="l10n_treasury.group_account_treasury_manager"
                />
            </header>
        </field>
    </record>

</odoo>

