<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <record model="ir.ui.view" id="own_check_reject_form">
        <field name="name">Own check reject form</field>
        <field name="model">account.own.check</field>
        <field name="inherit_id" ref="l10n_account_check.account_own_check_form"/>
        <field name="arch" type="xml">
            <header position="inside">
                <button name="reject_check" type="object" string="Rechazar" confirm="Está seguro?" invisible="state not in ['handed', 'reconciled']" groups="l10n_treasury.group_account_treasury_manager"/>
                <button name="revert_reject" type="object" string="Revertir rechazo" invisible="state != 'rejected'" groups="l10n_treasury.group_account_treasury_manager"/>
                <button name="cancel_check" type="object" string="Anular" confirm="Está seguro?" invisible="state != 'draft'" groups="l10n_treasury.group_account_treasury_manager"/>
                <button name="revert_canceled_check" type="object" string="Revertir anulacion" invisible="state != 'canceled'" groups="l10n_treasury.group_account_treasury_manager"/>
            </header>
        </field>
    </record>

</odoo>

