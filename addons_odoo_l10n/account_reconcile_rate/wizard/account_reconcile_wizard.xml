<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <record model="ir.ui.view" id="view_account_reconcile_wizard">
        <field name="name">view_account_reconcile_wizard</field>
        <field name="model">account.reconcile.wizard</field>
        <field name="inherit_id" ref="account_accountant.view_account_reconcile_wizard"/>
        <field name="arch" type="xml">
            <field name="journal_id" position="after">
                <field name="rate" required="not allow_partials and reco_currency_id != company_currency_id" invisible="reco_currency_id == company_currency_id"/>
            </field>
        </field>
    </record>

</odoo>

