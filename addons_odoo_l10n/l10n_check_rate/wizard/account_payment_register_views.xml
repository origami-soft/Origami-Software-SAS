<?xml version="1.0" encoding="UTF-8" ?>

<odoo>
    <record id="view_account_payment_register_form" model="ir.ui.view">
        <field name="name">view_account_payment_register_form</field>
        <field name="model">account.payment.register</field>
        <field name="inherit_id" ref="l10n_account_check.view_account_payment_register_form" />
        <field name="arch" type="xml">

            <!-- Cheques de terceros -->
            <xpath expr="//field[@name='account_third_check_ids']/tree/field[@name='rate']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='account_third_check_ids']/tree/field[@name='rate']" position="before">
                <field name="same_currency_as_payment" invisible="True" />
                <field name="natural_rate" invisible="same_currency_as_payment" />
            </xpath>

            <!-- Cheques propios -->
            <xpath expr="//field[@name='account_own_check_ids']/tree/field[@name='rate']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='account_own_check_ids']/tree/field[@name='rate']" position="before">
                <field name="same_currency_as_payment" invisible="True" />
                <field name="natural_rate" invisible="same_currency_as_payment" />
            </xpath>

            <!-- Cheques de terceros entregados -->
            <xpath expr="//field[@name='account_third_check_sent_ids']/tree/field[@name='sent_rate']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='account_third_check_sent_ids']/tree/field[@name='sent_rate']" position="before">
                <field name="same_currency_as_payment" invisible="True" />
                <field name="natural_sent_rate" invisible="same_currency_as_payment" />
            </xpath>

        </field>
    </record>
</odoo>

