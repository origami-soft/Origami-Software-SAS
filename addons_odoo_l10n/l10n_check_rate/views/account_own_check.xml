<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <record model="ir.ui.view" id="account_own_check_form">
        <field name="name">account_own_check_form</field>
        <field name="model">account.own.check</field>
        <field name="inherit_id" ref="l10n_account_check.account_own_check_form"/>
        <field name="arch" type="xml">
            <field name="rate" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>
            <field name="rate" position="before">
                <field
                    name="natural_rate"
                    invisible="same_currency_as_payment"
                    readonly="state != 'draft'"
                />
            </field>
        </field>
    </record>

</odoo>

