<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <record model="ir.ui.view" id="account_payment_type_lines_form">
        <field name="name">account_payment_type_lines_form</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="l10n_account_payment.account_payment_type_lines_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_type_line_ids']/tree/field[@name='rate']" position="attributes">
                <attribute name="column_invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='payment_type_line_ids']/tree/field[@name='rate']" position="before">
                <field name="natural_rate" invisible="same_currency_as_payment"/>
            </xpath>
        </field>
    </record>

</odoo>

