<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <data>

        <record model="ir.ui.view" id="account_payment_voucher_type_tree">
            <field name="name">Account payment voucher type tree</field>
            <field name="model">account.payment</field>
            <field name="inherit_id" ref="account.view_account_payment_tree"/>
            <field name="arch" type="xml">
                <field name="payment_method_line_id" position="after">
                    <field name="voucher_type_id"/>
                </field>
            </field>
        </record>

        <record id="view_account_payment_voucher_type_search" model="ir.ui.view">
            <field name="name">view_account_payment_voucher_type_search</field>
            <field name="model">account.payment</field>
            <field name="inherit_id" ref="account.view_account_payment_search"/>
            <field name="arch" type="xml">
                <field name="partner_id" position="after">
                    <field name="voucher_type_id"/>
                </field>
                <filter name="partner" position="after">
                    <filter string="Tipo de comprobante" name="voucher_type" domain="" context="{'group_by':'voucher_type_id'}"/>
                </filter>
            </field>
        </record>
   
        <record model="ir.ui.view" id="account_payment_voucher_type_form">
            <field name="name">Account payment voucher type form</field>
            <field name="model">account.payment</field>
            <field name="inherit_id" ref="l10n_point_of_sale.l10n_point_of_sale_payment_form"/>
            <field name="arch" type="xml">
                <field name="document_book_id" position="before">
                    <field
                        name="voucher_type_id"
                        string="Tipo de comprobante"
                        readonly="1"
                        invisible="not pos_ar_id"
                    />
                </field>
            </field>
        </record>

    </data>
</odoo>

