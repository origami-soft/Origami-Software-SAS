<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <data>

        <record model="ir.ui.view" id="account_move_reversal_voucher_type_sale_form">
            <field name="name">Account move reversal voucher type sale form</field>
            <field name="model">account.move.reversal</field>
            <field name="inherit_id" ref="account.view_account_move_reversal"/>
            <field name="arch" type="xml">
                <field name="date" position="before">
                    <field name="available_voucher_type_id" invisible="1"/>
                    <field name="voucher_type_id" domain="[('id', 'in', available_voucher_type_id), ('category', '=', 'refund')]"/>
                </field>
            </field>
        </record>

    </data>

</odoo>

