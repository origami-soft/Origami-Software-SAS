<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <record model="ir.ui.view" id="wizard_own_check_reconcile_form">
        <field name="name">wizard.own.check.reconcile.form</field>
        <field name="model">wizard.own.check.reconcile</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="date"/>
                    <field name="company_id" invisible="1"/>
                </group>
                <field name="line_ids" context="{'default_company_id': company_id}">
                    <tree create="false" editable="bottom">
                        <field name="check_id" readonly="True" force_save="1"/>
                        <field name="check_account_id" readonly="1" force_save="1"/>
                        <field name="account_id" readonly="1" force_save="1"/>
                        <field name="currency_id" column_invisible="True" force_save="1"/>
                        <field name="company_id" column_invisible="True"/>
                        <field name="amount" readonly="1" widget="monetary"
                               options="{'currency_field': 'currency_id'}" force_save="1"/>
                    </tree>
                </field>
                <footer>
                    <button name="confirm" string="Confirmar" type="object" class="oe_highlight"/>
                    <button string="Cancelar" class="oe_link" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>

