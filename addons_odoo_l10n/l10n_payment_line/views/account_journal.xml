<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <record model="ir.ui.view" id="account_journal_multiple_payment_form">
        <field name="name">account_journal_multiple_payment_form</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.view_account_journal_form"/>
        <field name="arch" type="xml">
            <field name="type" position="after">
                <field name="payment_usage" invisible="type not in ['bank', 'cash']"/>
                <field name="selectable_in_payments" invisible="type not in ['bank', 'cash']"/>
            </field>
            <field name="default_account_type" position="after">
                <field
                    name="multiple_payment_account_id"
                    invisible="payment_usage != 'document_book'"
                    required="payment_usage == 'document_book'"
                />
            </field>
        </field>
    </record>

</odoo>

