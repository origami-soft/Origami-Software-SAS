<odoo>
    <data>
        <record id="view_change_date" model="ir.ui.view">
            <field name="name">Cambiar Fecha</field>
            <field name="model">change.date.payment.type.wizard</field>
	        <field name="type">form</field>
            <field name="arch" type="xml">
                <form string="Selección nueva Fecha">
                    <p class="oe_gray">
                        Selecciona nueva Fecha
                    </p>
                    <group>
                        <group>
                            <field name="new_date"/>
                        </group>
                    </group>
                    <footer>
                        <button name="change_date" string="Apply" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-default" special="cancel" />
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>