<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <record model="ir.ui.view" id="view_account_payment_register_form">
        <field name="name">view_account_payment_register_form</field>
        <field name="model">account.payment.register</field>
        <field name="inherit_id" ref="account.view_account_payment_register_form"/>
        <field name="priority">19</field>
        <field name="arch" type="xml">
            <field name="payment_date" position="before">
                <field name="difference" readonly="1"/>
            </field>
            <footer position="before">
                <field name="show_payment_lines" invisible="1"/>
                <notebook name="payment_lines" invisible="not show_payment_lines"/>
            </footer>
            <field name="journal_id" position="attributes">
                <attribute name='domain'>[('type', 'in', ('bank', 'cash')), ('company_id', '=', company_id), ('selectable_in_payments', '=', True)]</attribute>
            </field>
        </field>
    </record>

</odoo>

