<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <record model="ir.ui.view" id="res_config_settings_view_form">
        <field name="name">res.config.settings.view.form.inherit.account.payment</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="l10n_payment_line.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <div id="account_payment_line_settings" position="inside">
                <div class="col-12 col-lg-6 o_setting_box" id="account_payment_settings">
                    <div class="o_setting_left_pane">
                        <field name="show_date_in_payment_type_line"/>
                    </div>
                    <div class="o_setting_right_pane">
                        <label for="show_date_in_payment_type_line"/>
                        <div class="text-muted">Si no se encuentra tildado, los asientos se generarán en base a la fecha del pago.</div>
                    </div>
                </div>
            </div>
        </field>
    </record>

</odoo>

