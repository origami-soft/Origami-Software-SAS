<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <record model="ir.ui.view" id="res_config_settings_view_form">
        <field name="name">res.config.settings.view.form.inherit.account.check</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="l10n_payment_line.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <div id="account_payment_line_settings" position="inside">
                <div class="col-12 col-lg-6 o_setting_box" id="account_check_settings">
                    <div class="o_setting_left_pane"/>
                    <div class="o_setting_right_pane">
                        <span class="o_form_label">Configuración de cheques</span>
                        <span class="fa fa-lg fa-building-o" title="Los valores establecidos aquí son específicos de la empresa." aria-label="Los valores establecidos aquí son específicos de la empresa." groups="base.group_multi_company" role="img"/>
                        <div class="text-muted">
                                            Diarios por defecto al cargar cheques en pagos
                        </div>
                        <div class="content-group">
                            <div class="row mt16">
                                <label for="account_third_check_journal_id" class="col-lg-4 o_light_label"/>
                                <field name="account_third_check_journal_id" options="{'no_create_edit': True, 'no_open': True}" context="{'active_test': False}"/>
                            </div>
                            <div class="row">
                                <label for="account_own_check_journal_id" class="col-lg-4 o_light_label"/>
                                <field name="account_own_check_journal_id" options="{'no_create_edit': True, 'no_open': True}" context="{'active_test': False}"/>
                            </div>
                        </div>
                        <div class="text-muted mt16">
                            Banco por defecto al cargar cheques propios
                        </div>
                        <div class="content-group">
                            <div class="row">
                                <field name="own_check_bank_id" options="{'no_create_edit': True, 'no_open': True}"/>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </field>
    </record>

</odoo>

