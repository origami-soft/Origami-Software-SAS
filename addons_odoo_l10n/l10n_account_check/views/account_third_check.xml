<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <record model="ir.ui.view" id="account_third_check_form">
        <field name="name">Account third check form</field>
        <field name="model">account.third.check</field>
        <field name="arch" type="xml">
            <form delete="false" create="false">
                <header>
                    <button name="open_correct_wizard" type="object" string="Corregir"
                            groups="l10n_treasury.group_account_treasury_manager"
                            invisible="state == 'draft'"/>
                    <field name="state" widget="statusbar" nolabel="1" statusbar_visible="draft,handed"/>
                </header>
                <sheet>
                    <h1>
                        <span>CHEQUE N° </span>
                        <field name="name" class="oe_inline" readonly="state != 'draft'"/>
                    </h1>
                    <h1 class="mt0">
                        <span>IMPORTE: </span>
                        <field name="currency_id" invisible="1"/>
                        <field name="amount" readonly="1"/>
                    </h1>
                    <group>
                        <group>
                            <field name="journal_id" groups="base.group_multi_company" readonly="state != 'draft'"/>
                            <field name="issue_date" readonly="state != 'draft'"/>
                            <field name="check_type" readonly="state != 'draft'"/>
                            <field name="not_to_order" readonly="state not in ['draft', 'wallet']"/>
                        </group>
                        <group>
                            <field name="bank_id" readonly="state != 'draft'"/>
                            <field name="payment_date" readonly="state != 'draft' or check_type == 'common'" force_save="1"/>
                            <field name="issue_name" readonly="state != 'draft'"/>
                            <field name="company_id" readonly="state != 'draft'" groups="base.group_multi_company"/>
                        </group>
                    </group>
                    <group>
                        <group string="Pago origen" invisible="not payment_id">
                            <field name="payment_id" readonly="1" string="Referencia"/>
                            <field name="partner_id"/>
                            <field name="payment_currency_amount" readonly="state != 'draft'"/>
                            <field name="rate" invisible="same_currency_as_payment and state != 'draft'"/>
                            <field name="payment_currency_id" invisible="1"/>
                            <field name="same_currency_as_payment" invisible="1"/>
                        </group>
                        <group string="Pago destino" invisible="not destination_payment_id">
                            <field name="destination_payment_id" readonly="True" string="Referencia"/>
                            <field name="destination_partner_id"/>
                            <field
                                name="sent_payment_currency_amount"
                                readonly="True"
                                string="Monto en moneda de pago"
                                widget="monetary"
                                options="{'currency_field': 'sent_payment_currency_id'}"
                            />
                            <field
                                name="sent_rate"
                                readonly="True"
                                string="Cotización"
                                invisible="same_currency_as_sent_payment"
                            />
                            <field name="sent_payment_currency_id" invisible="1"/>
                            <field name="same_currency_as_sent_payment" invisible="1"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread" options="{&quot;thread_level&quot;: 1}"/>
                </div>
            </form>
        </field>
    </record>

    <record model="ir.ui.view" id="account_third_check_tree">
        <field name="name">Account third check tree</field>
        <field name="model">account.third.check</field>
        <field name="arch" type="xml">
            <tree create="false"
                  delete="false"
                  decoration-info="state=='draft'"
                  decoration-danger="state=='rejected'"
                  decoration-success="state=='wallet'"
            >
                <field name="name"/>
                <field name="issue_date"/>
                <field name="partner_id"/>
                <field name="destination_partner_id"/>
                <field name="payment_date"/>
                <field name="bank_id"/>
                <field name="check_type"/>
                <field name="not_to_order"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="amount" sum='Total' widget="monetary" options="{'currency_field': 'currency_id'}"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

    <record model="ir.ui.view" id="account_third_check_kanban">
        <field name="name">Account third check kanban</field>
        <field name="model">account.third.check</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_mobile" 
                    create="false">
                <field name="name"/>
                <field name="issue_date"/>
                <field name="payment_date"/>
                <field name="bank_id"/>
                <field name="check_type"/>
                <field name="not_to_order"/>
                <field name="currency_id"/>
                <field name="amount"/>
                <field name="state"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                            <div class="o_kanban_record_top mb16">
                                <div class="o_kanban_record_headings mt4">
                                    <strong class="o_kanban_record_title"><span><t t-esc="record.name.value"/></span></strong>
                                </div>
                                <strong><field name="amount" widget="monetary"/></strong>
                            </div>
                            <div class="o_kanban_record_bottom">
                                <div class="oe_kanban_bottom_left text-muted">
                                    <span><t t-esc="record.bank_id.value"/> (<t t-esc="record.check_type.value"/>)</span>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <field name="state" widget="label_selection"
                                           options="{'classes': {'draft': 'info', 'canceled': 'danger', 'handed': 'success', 'deposited': 'success'}}"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record model="ir.ui.view" id="account_third_check_search">
        <field name="name">Account third check search</field>
        <field name="model">account.third.check</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="issue_date"/>
                <field name="payment_date"/>
                <field name="bank_id"/>
                <field name="check_type"/>
                <field name="not_to_order"/>
                <field name="amount"/>
                <field name="state"/>
            </search>
        </field>
    </record>

    <record model="ir.ui.view" id="account_third_check_calendar">
        <field name="name">Account third check calendar</field>
        <field name="model">account.third.check</field>
        <field name="arch" type="xml">
            <calendar string="Cheques" color="bank_id" date_start="payment_date" mode="month" quick_create="false">
                <field name="name"/>
                <field name="bank_id"/>
                <field name="amount"/>
            </calendar>
        </field>
    </record>

    <record id="action_third_checks_view" model="ir.actions.act_window">
        <field name="name">Cheques de terceros</field>
        <field name="res_model">account.third.check</field>
        <field name="view_mode">tree,kanban,form,calendar,pivot,graph</field>
    </record>

</odoo>

