<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <data>

        <record model="ir.ui.view" id="customer_statements_form">
            <field name="name">Customer statements form</field>
            <field name="model">res.partner</field>
            <field name="inherit_id" ref="account_followup.customer_statements_form_view"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='unreconciled_aml_ids']/tree/field[@name='move_name']" position="attributes">
                    <attribute name="column_invisible">True</attribute>
                </xpath>
                <xpath expr="//field[@name='unreconciled_aml_ids']/tree/field[@name='move_name']" position="after">
                    <field name="full_voucher_name" string="Número" widget="open_move_widget"/>
                </xpath>
            </field>
        </record>

    </data>
</odoo>

