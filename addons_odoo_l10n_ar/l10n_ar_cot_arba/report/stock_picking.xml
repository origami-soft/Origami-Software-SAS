<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <template id="report_selfprint_body" inherit_id="l10n_ar_stock_picking_report.report_footer">
        <xpath expr="//span[@t-field='o.cai']" position="after">
            <t t-if="o.cot">
                <br/><b>COT:</b> <span t-field="o.cot"/>
            </t>
        </xpath>
        <xpath expr="//span[@t-field='o.cai']/.." position="attributes">
            <attribute name="style">width:40%;overflow:hidden;line-height: 0.75cm</attribute>
        </xpath>
    </template>

</odoo>

