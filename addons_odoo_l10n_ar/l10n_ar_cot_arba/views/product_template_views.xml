<odoo>

    <record id="product_template_form_view" model="ir.ui.view">
        <field name="name">product product</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="groups_id" eval="[(4, ref('l10n_ar_cot_arba.arba_cot_enabled'))]"/>
        <field name="arch" type="xml">
            <field name="categ_id" position="after">
                <label for="unique_product_code"/>
                <div class="oe_inline">
                    <field name="unique_product_code" class="oe_inline"/>
                    <button name="action_arba_codes" type="object" string="Ver Nomenclador" class="oe_edit_only oe_inline"/>
                </div>
            </field>
        </field>
    </record>

</odoo>

