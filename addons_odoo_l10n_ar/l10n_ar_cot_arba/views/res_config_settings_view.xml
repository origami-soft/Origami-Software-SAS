<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <record model="ir.ui.view" id="res_config_settings_view_form">
        <field name="name">res.config.settings.view.form</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
        <field name="model">res.config.settings</field>
        <field name="arch" type="xml">
            <block name="operations_setting_container" position="before">
                <block title="COT de ARBA">
                    <setting string="Usar COT de ARBA">
                        <field name="group_arba_cot_enabled"/>
                        <div class="text-muted">
                            Permite generar el COT de arba una vez que se han asignado números de remitos en las entregas.
                        </div>
                    </setting>
                    <setting company_dependent="1">
                        <field name="cot_arba_key" class="oe_inline" password="True" />
                        <div class="text-muted" invisible="not group_arba_cot_enabled">
                            Indique la clave COT utilizada para generación de remito electrónico / COT. Puede probarla intentando subir cualquier archivo en este <a target="_blank" href="https://cot.arba.gov.ar/TransporteBienes/pages/remitos/PresentarRemitos.jsp">link</a> (el usuario es el CUIT). Si da error en nombre de archivo entonces la clave es correcta.
                        </div>
                    </setting>
                    <setting class="col-xs-12 col-md-6 o_setting_box">
                        <div class="content-group">
                            <div class="content-group" invisible="not group_arba_cot_enabled">
                                <div class="row">
                                    <label for="cot_path_type" class="col-md-6 o_light_label" string="Ruta por defecto"/>
                                    <field name="cot_path_type" class="oe_inline" />
                                </div>
                                <div class="row">
                                    <label for="cot_partner_id" class="col-md-6 o_light_label" string="Transportista por defecto"/>
                                    <field name="cot_partner_id" class="oe_inline"/>
                                </div>
                                <div class="row">
                                    <label for="cot_prod_no_term_dev" class="col-md-6 o_light_label" string="Terminos de producto por defecto"/>
                                    <field name="cot_prod_no_term_dev" class="oe_inline" />
                                </div>
                            </div>
                            <div class="text-muted" invisible="not group_arba_cot_enabled">
                                Los campos definidos previamente se usaran por defecto al obtener COT
                            </div>
                        </div>
                    </setting>
                </block>
            </block>
        </field>
    </record>

</odoo>

