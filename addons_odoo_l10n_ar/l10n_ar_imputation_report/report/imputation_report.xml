<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <data noupdate="0">

        <record id="imputation_paper_format" model="report.paperformat">
            <field name="name">Papel reporte de imputaciones</field>
            <field name="margin_top">40</field>
            <field name="orientation">Portrait</field>
            <field name="margin_bottom">40</field>
            <field name="margin_left">5</field>
            <field name="margin_right">5</field>
            <field name="header_spacing">40</field>
        </record>

        <record id="action_imputation_report" model="ir.actions.report">
            <field name="name">Reporte de imputaciones</field>
            <field name="model">account.move</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">l10n_ar_imputation_report.report_imputation</field>
            <field name="report_file">l10n_ar_imputation_report.report_imputation</field>
            <field name="print_report_name">object.full_voucher_name</field>
            <field name="binding_model_id" ref="model_account_move"/>
            <field name="paperformat_id" ref="imputation_paper_format"/>
            <field name="binding_type">report</field>
        </record>

    </data>

</odoo>

