<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <template id="report_imputation_document">
            <t t-call="web.external_layout">
                <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang)"/>
                <div class="page">
                    <div class="oe_structure"/>

                    <h1 class="text-center mt16">Reporte de imputación</h1>

                    <div class="row mt32 mb32" id="informations">
                        <div class="col-12">
                            <div class="row">
                                <div class="col-12 mw-100 mb-2">
                                    <strong>Razón social: </strong>
                                    <p class="m-0" t-field="doc.partner_id.name"/>
                                </div>
                            </div>
                            <div class="row">
                                <div class="col-auto  mw-100 mb-2">
                                    <strong>Documento :</strong>
                                    <p class="m-0" t-field="doc.display_name"/>
                                </div>
                                <div class="col-auto  mw-100 mb-2">
                                    <strong>Fecha: </strong>
                                    <p class="m-0" t-field="doc.invoice_date" t-options="{&quot;widget&quot;: &quot;date&quot;}"/>
                                </div>
                                <div class="col-auto  mw-100 mb-2">
                                    <strong>Adeudado:</strong>
                                    <p class="m-0" t-field="doc.amount_residual" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: doc.currency_id}"/>
                                </div>
                                <div class="col-auto mw-100 mb-2">
                                    <strong>Total:</strong>
                                    <p class="m-0" t-esc="doc.tax_totals['formatted_amount_total']"/>
                                </div>
                                <div t-if="doc.currency_rate" class="col-auto mw-100 mb-2">
                                    <strong>Tipo de cambio:</strong>
                                    <p class="m-0" t-field="doc.currency_rate" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: doc.company_id.currency_id}"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <table class="table table-sm o_main_table table-borderless">
                        <thead style="display: table-row-group">
                            <tr class="bg-200">
                                <th name="th_document" class="text-start">Documento</th>
                                <th name="th_date" class="text-start">Fecha</th>
                                <th name="th_total" class="text-end">Total</th>
                                <th name="th_imputation" class="text-end">Imputación</th>
                            </tr>
                        </thead>
                        <tbody class="sale_tbody">
                            <t t-foreach="doc.get_report_imputations()" t-as="line">
                                <tr>
                                    <td name="td_doc" class="text-start">
                                        <span t-esc="line['document']"/>
                                    </td>
                                    <td name="td_date" class="text-start">
                                        <span t-esc="line['date']" t-options='{"widget": "date"}'/>
                                    </td>
                                    <td name="td_total" class="text-end">
                                        <span t-esc="line['total']" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                    </td>
                                    <td name="td_imputation" class="text-end">
                                        <span t-esc="line['imputation']" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>

                    <div class="clearfix" name="total_summary">
                        <div id="total" class="row" name="total">
                            <div t-attf-class="#{'col-6' if report_type != 'html' else 'col-sm-7 col-md-6'} ms-auto">
                                <table class="table table-sm table-borderless">
                                    <tr class="border-black o_subtotal">
                                        <t t-set="total" t-value="doc.amount_total - doc.amount_residual"/>
                                        <td>
                                            <strong>Total imputaciones</strong>
                                        </td>
                                        <td class="text-end">
                                            <span t-esc="total" t-options='{"widget": "monetary", "display_currency": doc.currency_id}'/>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </t>
        </template>


        <template id="report_imputation">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="doc">
                    <t t-call="l10n_ar_imputation_report.report_imputation_document" t-lang="doc.partner_id.lang"/>
                </t>
            </t>
        </template>
    </data>

</odoo>

