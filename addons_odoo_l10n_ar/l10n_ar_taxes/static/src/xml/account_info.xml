<?xml version="1.0" encoding="UTF-8"?>

<templates xml:space="preserve">

    <t t-name="l10n_ar_taxes.AccountMoveShowAmountInfoField">
        <div>
            <t t-set="info" t-value="this.getInfo()"/>
            <table style="width:100%;">
                <t t-foreach="info.lines" t-as="line" t-key="line_index">
                    <tr>
                    <t>
                        <td>
                           <a role="button" tabindex="0" class="js_payment_info fa fa-info-circle" t-att-index="line_index" style="margin-right:5px;" aria-label="Info" title="Journal Entry Info" data-bs-toggle="tooltip" t-on-click.stop="(ev) => this.onInfoClick(ev, line)"></a>
                        </td>
                        <td>
                            <i class="o_field_widget text-start o_payment_label">
                                Información de importes
                            </i>
                        </td>
                    </t>
                    </tr>
                </t>
            </table>
        </div>
    </t>

    <t t-name="l10n_ar_taxes.AccountMoveShowAmountInfoPopOver">
        <div class="account_move_show_amount_info_popover">
            <h3 t-if="props.title" class="o_popover_header"><t t-out="props.title"/></h3>
            <div class="px-2">
                <div>
                    <table>
                        <tr>
                            <td><strong>Neto gravado: </strong></td>
                            <td>
                                <t t-out="props.amount_to_tax_formatted"/>
                            </td>
                        </tr>
                        <tr>
                            <td><strong>No gravado: </strong></td>
                            <td>
                                <t t-out="props.amount_not_taxable_formatted"/>
                            </td>
                        </tr>
                        <tr>
                            <td><strong>Exento: </strong></td>
                            <td>
                                <t t-out="props.amount_exempt_formatted"/>
                            </td>
                        </tr>
                    </table>
                </div>
              </div>
        </div>
    </t>

</templates>
