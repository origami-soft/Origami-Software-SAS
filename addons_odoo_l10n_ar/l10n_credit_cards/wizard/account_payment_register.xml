<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <record model="ir.ui.view" id="view_account_payment_register_form">
        <field name="name">view_account_payment_register_form</field>
        <field name="model">account.payment.register</field>
        <field name="inherit_id" ref="l10n_payment_line.view_account_payment_register_form"/>
        <field name="priority">19</field>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page name="credit_card_lines" string="Tarjetas de crédito">
                    <field name="credit_card_line_ids" nolabel="1" colspan="2">
                        <tree editable="bottom">
                            <field name="company_id" column_invisible="1"/>
                            <field name="payment_id" column_invisible="1"/>
                            <field name="payment_currency_id" column_invisible="1"/>
                            <field name="journal_id" column_invisible="1"/>
                            <field name="credit_card_id" domain="['|', ('type', '=', parent.payment_type == 'outbound' and parent.partner_type == 'supplier' and 'purchase'),
                                                                       ('type', '=', parent.partner_type == 'customer' and 'sale')]"/>
                            <field name="payment_plan_id"/>
                            <field name="currency_id"/>
                            <field name="same_currency_as_payment" column_invisible="1"/>
                            <field name="rate" invisible="same_currency_as_payment"/>
                            <field name="amount"/>
                            <field name="payment_currency_amount"/>
                            <field name="name" string="N° Cupón"/>
                        </tree>
                        <form>
                            <group>
                                <field name="credit_card_id"/>
                                <field name="payment_plan_id"/>
                                <field name="currency_id"/>
                            </group>
                            <group>
                                <field name="name" string="N° Cupón"/>
                                <field name="amount"/>
                                <field name="same_currency_as_payment" invisible="1"/>
                                <field name="rate" invisible="same_currency_as_payment"/>
                            </group>
                        </form>
                    </field>
                </page>
            </notebook>
        </field>
    </record>

</odoo>

