<odoo>

    <record id="point_of_sale.pos_invoice_report" model="ir.actions.report">
        <field name="report_name">l10n_ar_electronic_invoice_report_pos.report_invoice</field>
        <field name="paperformat_id" ref="l10n_ar_electronic_invoice_report.electronic_invoice_paper_format"/>
    </record>

    <template id="report_invoice">
        <t t-if="docs and docs[0].cae">
            <t t-call="l10n_ar_electronic_invoice_report.report_electronic_invoice"/>
        </t>
        <t t-else="">
            <t t-call="account.report_invoice"/>
        </t>
    </template>

</odoo>

