<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <data>

        <record model="ir.ui.view" id="document_book_ar_form">
            <field name="name">Document book ar form</field>
            <field name="model">document.book</field>
            <field name="inherit_id" ref="l10n_point_of_sale.document_book_form"/>
            <field name="arch" type="xml">
                <field name="voucher_type_id" position="after">
                    <field name="last_number"/>
                </field>
            </field>
        </record>

        <record model="ir.ui.view" id="document_book_ar_tree">
            <field name="name">Document book ar tree</field>
            <field name="model">document.book</field>
            <field name="inherit_id" ref="l10n_point_of_sale.document_book_tree"/>
            <field name="arch" type="xml">
                <field name="voucher_type_id" position="after">
                    <field name="last_number"/>
                </field>
            </field>
        </record>

    </data>
</odoo>

