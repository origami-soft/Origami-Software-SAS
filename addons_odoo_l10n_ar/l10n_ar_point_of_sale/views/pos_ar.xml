<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <data>

        <record model="ir.ui.view" id="pos_ar_form_ar">
            <field name="name">Pos ar form ar</field>
            <field name="model">pos.ar</field>
            <field name="inherit_id" ref="l10n_point_of_sale.pos_ar_form"/>
            <field name="arch" type="xml">
                <field name="name" position="after">
                    <field name="prefix_quantity"/>
                    <field name="company_activity_ids" invisible="1"/>
                    <field name="activity_id" options="{'no_create': True}" domain="[('id', 'in', company_activity_ids)]"/>
                </field>
                <field name="book_type_id" position="after">
                    <field name="last_number"/>
                </field>
            </field>
        </record>

    </data>
</odoo>

