<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <record model="ir.ui.view" id="view_account_payment_register_form">
        <field name="name">view_account_payment_register_form</field>
        <field name="model">account.payment.register</field>
        <field name="inherit_id" ref="account.view_account_payment_register_form"/>
        <field name="arch" type="xml">
            <div name="amount_div" position="after">
                <field name="need_rate" invisible="1"/>
                <field name="currency_rate" string="Cotización pago" groups="base.group_multi_currency"
                    invisible="not need_rate" />
                <field name="current_currency_rate" groups="base.group_multi_currency" invisible="not need_rate"/>
                <div class="alert alert-warning" role="alert" colspan="2" invisible="not need_rate">
                    Si carga una cotización en <strong>cotización pago</strong>, se utilizará la misma para hacer las conversiones. De lo contrario se utilizará la <strong>cotización actual</strong>.
                </div>
            </div>
        </field>
    </record>

</odoo>

