<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <data>

        <record model="ir.ui.view" id="view_move_form">
            <field name="name">view_move_form</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <group id="header_left_group" position="inside">
                    <field name="vat_diary_concept" invisible="1"/>
                    <field name="supplier_concept"
                           string="Concepto"
                           invisible="not (move_type in ('in_invoice', 'in_refund') and vat_diary_concept)"
                           required="move_type in ('in_invoice', 'in_refund') and vat_diary_concept"
                           readonly="state != 'draft'"
                    />
                </group>
            </field>
        </record>

    </data>
</odoo>

