<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <record model="ir.ui.view" id="vat_diary_view_form">
        <field name="name">Vat diary view form</field>
        <field name="model">vat.diary</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="generate_xls_report" type="object" string="Generar XLS"/>
                    <button name="generate_csv_report" type="object" string="Generar CSV"/>
                    <button name="generate_pdf_report" type="object" string="Descargar PDF"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="date_from" widget="daterange" options="{'end_date_field': 'date_to'}"/>
                            <field name="date_to" invisible="1"/>
                            <field name="type"/>
                        </group>
                        <group>
                            <field name="separate_not_taxable_from_exempt"/>
                            <field name="include_suffered_retentions" invisible="type != 'purchases'"/>
                            <field name="report" invisible="not report" filename="report_filename" widget="binary"/>
                            <field name="report_filename" invisible="1"/>
                            <field name="csv_report" invisible="not csv_report" filename="csv_report_filename" widget="binary"/>
                            <field name="csv_report_filename" invisible="1"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.ui.view" id="vat_diary_view_tree">
        <field name="name">Vat diary view tree</field>
        <field name="model">vat.diary</field>
        <field name="arch" type="xml">
            <tree>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="type"/>
            </tree>
        </field>
    </record>

    <record id="action_view_vat_diary" model="ir.actions.act_window">
        <field name="name">Subdiario IVA</field>
        <field name="res_model">vat.diary</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem
        id="vat_diary_menu"
        name="Subdiario IVA"
        action="action_view_vat_diary"
        parent="l10n_ar_bo.reports_ar_main_menu"
        sequence="10"
    />

</odoo>

