<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <template id="vat_diary_layout">
        <div class="header">
            <t t-set="company" t-value="o.env.company"/>
            <table class="table-borderless" style="width:100%">
                <tbody>
                    <tr>
                        <td style="text-align: left; width:50%"><strong>Razón social:</strong> <span t-esc="company.name"/></td>
                        <td style="text-align: right; width:50%"><strong>Emisión:</strong> <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%d/%m/%Y')"/></td>
                    </tr>
                    <tr>
                        <td style="text-align: left; width:50%"><strong>CUIT:</strong> <span t-esc="company.vat"/></td>
                    </tr>
                </tbody>
            </table>
            <h2 style="text-align: center; padding-bottom: 10px;">
                <strong>Subdiario de IVA <span t-field="o.type"/></strong>
            </h2>
            <table class="table-borderless" style="width:100%">
                <tbody>
                    <tr>
                        <td style="text-align: center; width:50%"><strong>Desde:</strong> <span t-field="o.date_from" t-options="{'widget': 'date'}"/></td>
                        <td style="text-align: center; width:50%"><strong>Hasta:</strong> <span t-field="o.date_to" t-options="{'widget': 'date'}"/></td>
                    </tr>
                </tbody>
            </table>
        </div>
        <div t-attf-class="article o_report_layout_standard o_company_#{company.id}_layout" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id" t-att-data-oe-lang="o and o.env.context.get('lang')">
            <t t-raw="0"/>
        </div>
        <div class="footer">
            <div class="text-right">
              <span class="page"/>
            </div>
        </div>
    </template>

    <template id="pdf_vat_diary_report">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="l10n_ar_vat_diary.vat_diary_layout">
                    <div class="page" style="font-size:13px;">
                        <table class="table table-sm o_main_table table-borderless" style="border-style: solid hidden; border-width: 2px; border-color:black;" cellpadding="0px" cellspacing="0px" padding="0px" margin="0px">
                            <thead>
                                <tr style="border: 2px solid black;">
                                    <th width="6%"><strong>Fecha</strong></th>
                                    <th width="8%"><strong>Comprobante</strong></th>
                                    <th width="8%"><strong>Razón social</strong></th>
                                    <th width="8%"><strong>CUIT</strong></th>
                                    <th width="7%" style="text-align: right;"><strong>Neto grav.</strong></th>
                                    <th width="15%" style="text-align: right;"><strong>IVA - Monto</strong></th>
                                    <th width="15%" style="text-align: right;"><strong>Impuestos internos - Monto</strong></th>
                                    <t t-if="o.separate_not_taxable_from_exempt">
                                        <th width="6%" style="text-align: right;"><strong>Exento</strong></th>
                                        <th width="6%" style="text-align: right;"><strong>No gravado</strong></th>
                                    </t>
                                    <t t-else="">
                                        <th width="12%" style="text-align: right;"><strong>Exento / No gravado</strong></th>
                                    </t>

                                    <th width="15%" style="text-align: right;"><strong>Regimen especial - Monto</strong></th>
                                    <th width="6%" style="text-align: right;"><strong>Total</strong></th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="moves" t-as="move">
                                    <tr style="border: 1,5px solid black;">
                                        <td width="6%"><span t-esc="move['date']"/></td>
                                        <td width="8%"><span t-esc="move['voucher_type'] + ' ' + move['voucher']"/></td>
                                        <td width="8%"><span t-esc="move['partner']"/></td>
                                        <td width="8%"><span t-esc="move['vat']"/></td>
                                        <td width="7%" style="text-align:right;"><span t-esc="move.get('to_tax', 0.0)" t-options='{"widget": "float", "decimal_precision": "2"}'/></td>
                                        <td width="15%" style="text-align:right;">
                                            <t t-foreach="move.get('iva', {}).keys()" t-as="key">
                                                <span t-esc="move.get('iva').get(key).get('name') + ' - ' "/><span t-esc="move.get('iva').get(key).get('amount', 0.0)" t-options='{"widget": "float", "decimal_precision": "2"}'/><br/>
                                            </t>
                                        </td>
                                        <td width="15%" style="text-align:right;">
                                            <t t-foreach="move.get('not_iva_perception', {}).keys()" t-as="key">
                                                <span t-esc="move.get('not_iva_perception').get(key).get('name') + ' - ' "/><span t-esc="move.get('not_iva_perception').get(key).get('amount', 0.0)" t-options='{"widget": "float", "decimal_precision": "2"}'/><br/>
                                            </t>
                                        </td>
                                        <t t-if="o.separate_not_taxable_from_exempt">
                                                <td width="6%" style="text-align:right;"><span t-esc="move.get('exempt', 0.0)" t-options='{"widget": "float", "decimal_precision": "2"}' /></td>
                                                <td width="6%" style="text-align:right;"><span t-esc="move.get('not_taxable', 0.0)" t-options='{"widget": "float", "decimal_precision": "2"}'/></td>
                                        </t>
                                        <t t-else="">
                                            <td width="12%" style="text-align:right;"><span t-esc="move.get('exempt', 0.0) + move.get('not_taxable', 0.0)" t-options='{"widget": "float", "decimal_precision": "2"}'/></td>
                                        </t>
                                        <td width="15%" style="text-align:right;">
                                            <t t-if="move.get('retention')">
                                                <span t-esc="move.get('retention')"/>
                                            </t>
                                            <t t-foreach="move.get('perceptions', {}).keys()" t-as="key">
                                                <span t-esc="move.get('perceptions').get(key).get('name') + ' - '"/><span t-esc="move.get('perceptions').get(key).get('amount', 0.0)" t-options='{"widget": "float", "decimal_precision": "2"}'/><br/>
                                            </t>
                                        </td>
                                        <td width="6%" style="text-align:right;"><span t-esc="move['total']" t-options='{"widget": "float", "decimal_precision": "2"}'/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                        <p style="page-break-before:always;"> </p>
                        <h5 style="text-align: left; padding-bottom: 10px;">
                            <strong>TOTALES DE OPERACIONES QUE GENERAN CRÉDITO FISCAL</strong>
                        </h5>
                        <table class="table table-sm o_main_table table-borderless" style="border-style: solid hidden; border-width: 2px; border-color:black;" cellpadding="0px" cellspacing="0px" padding="0px" margin="0px">
                            <thead>
                                <tr style="border: 2px solid black;">
                                    <th width="25%"><strong>Impuesto</strong></th>
                                    <th width="25%" style="text-align: right;"><strong>Neto grav.</strong></th>
                                    <th width="25%" style="text-align: right;"><strong>Monto de impuesto</strong></th>
                                    <th width="25%" style="text-align: right;"><strong>Total</strong></th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="amount" t-value="0"/>
                                <t t-set="base" t-value="0"/>
                                <t t-foreach="credits.keys()" t-as="key">
                                    <tr style="border: 1,5px solid black;">
                                        <td width="25%">
                                            <span t-esc="credits.get(key).get('name')"/>
                                        </td>
                                        <td width="25%" style="text-align:right;">
                                            <span t-esc="credits.get(key).get('base', 0.0)" t-options='{"widget": "float", "decimal_precision": "2"}'/>
                                        </td>
                                        <td width="25%" style="text-align:right;">
                                            <span t-esc="credits.get(key).get('amount', 0.0)" t-options='{"widget": "float", "decimal_precision": "2"}'/>
                                        </td>
                                        <td width="25%" style="text-align:right;">
                                            <span t-esc="credits.get(key).get('amount', 0.0) + credits.get(key).get('base', 0.0)" t-options='{"widget": "float", "decimal_precision": "2"}'/>
                                        </td>
                                    </tr>
                                    <t t-set="amount" t-value="amount + credits.get(key).get('amount', 0.0)"/>
                                    <t t-set="base" t-value="base + credits.get(key).get('base', 0.0)"/>
                                </t>
                            </tbody>
                        </table>
                        <table class="table table-sm o_main_table table-borderless" style="border-style: solid hidden; border-width: 2px; border-color:black;" cellpadding="0px" cellspacing="0px" padding="0px" margin="0px">
                            <tbody>
                                <tr>
                                    <td width="25%"><span>SubTotal</span></td>
                                    <td width="25%" style="text-align:right;">
                                        <span t-esc="base" t-options='{"widget": "float", "decimal_precision": "2"}'/>
                                    </td>
                                    <td width="25%" style="text-align:right;">
                                        <span t-esc="amount" t-options='{"widget": "float", "decimal_precision": "2"}'/>
                                    </td>
                                    <td width="25%" style="text-align:right;">
                                        <span t-esc="amount + base" t-options='{"widget": "float", "decimal_precision": "2"}'/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                        <h5 style="text-align: left; padding-bottom: 10px;">
                            <strong>REGIMENES ESPECIALES</strong>
                        </h5>
                        <table class="table table-sm o_main_table table-borderless" style="border-style: solid hidden; border-width: 2px; border-color:black;" cellpadding="0px" cellspacing="0px" padding="0px" margin="0px">
                            <thead>
                                <tr style="border: 2px solid black;">
                                    <th width="50%"><strong>Nombre</strong></th>
                                    <th width="50%" style="text-align: right;"><strong>Total</strong></th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="amount" t-value="0"/>
                                <t t-foreach="special_regimes.keys()" t-as="key">
                                    <tr style="border: 1,5px solid black;">
                                        <td width="50%">
                                            <span t-esc="special_regimes.get(key).get('name')"/>
                                        </td>
                                        <td width="50%" style="text-align:right;">
                                            <span t-esc="special_regimes.get(key).get('amount', 0.0)" t-options='{"widget": "float", "decimal_precision": "2"}'/>
                                        </td>
                                    </tr>
                                    <t t-set="amount" t-value="amount + special_regimes.get(key).get('amount', 0.0)"/>
                                </t>
                            </tbody>
                        </table>
                        <table class="table table-sm o_main_table table-borderless" style="border-style: solid hidden; border-width: 2px; border-color:black;" cellpadding="0px" cellspacing="0px" padding="0px" margin="0px">
                            <tbody>
                                <tr>
                                    <td width="50%"><span>Subtotal</span></td>
                                    <td width="50%" style="text-align:right;">
                                        <span t-esc="amount" t-options='{"widget": "float", "decimal_precision": "2"}'/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                        <h5 style="text-align: left; padding-bottom: 10px;">
                            <strong>TOTALES DE OPERACIONES QUE GENERAN DÉBITO FISCAL</strong>
                        </h5>
                        <table class="table table-sm o_main_table table-borderless" style="border-style: solid hidden; border-width: 2px; border-color:black;" cellpadding="0px" cellspacing="0px" padding="0px" margin="0px">
                            <thead>
                                <tr style="border: 2px solid black;">
                                    <th width="25%"><strong>Impuesto</strong></th>
                                    <th width="25%" style="text-align: right;"><strong>Neto Grav.</strong></th>
                                    <th width="25%" style="text-align: right;"><strong>Monto de impuesto</strong></th>
                                    <th width="25%" style="text-align: right;"><strong>Total</strong></th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="amount" t-value="0"/>
                                <t t-set="base" t-value="0"/>
                                <t t-foreach="debits.keys()" t-as="key">
                                    <tr style="border: 1,5px solid black;">
                                        <td width="25%">
                                            <span t-esc="debits.get(key).get('name')"/>
                                        </td>
                                        <td width="25%" style="text-align:right;">
                                            <span t-esc="debits.get(key).get('base', 0.0)" t-options='{"widget": "float", "decimal_precision": "2"}'/>
                                        </td>
                                        <td width="25%" style="text-align:right;">
                                            <span t-esc="debits.get(key).get('amount', 0.0)" t-options='{"widget": "float", "decimal_precision": "2"}'/>
                                        </td>
                                        <td width="25%" style="text-align:right;">
                                            <span t-esc="debits.get(key).get('amount', 0.0) + debits.get(key).get('base', 0.0)" t-options='{"widget": "float", "decimal_precision": "2"}'/>
                                        </td>
                                    </tr>
                                    <t t-set="amount" t-value="amount + debits.get(key).get('amount', 0.0)"/>
                                    <t t-set="base" t-value="base + debits.get(key).get('base', 0.0)"/>
                                </t>
                            </tbody>
                        </table>
                        <table class="table table-sm o_main_table table-borderless" style="border-style: solid hidden; border-width: 2px; border-color:black;" cellpadding="0px" cellspacing="0px" padding="0px" margin="0px">
                            <tbody>
                                <tr>
                                    <td width="25%"><span>Subtotal</span></td>
                                    <td width="25%" style="text-align:right;">
                                        <span t-esc="base" t-options='{"widget": "float", "decimal_precision": "2"}'/>
                                    </td>
                                    <td width="25%" style="text-align:right;">
                                        <span t-esc="amount" t-options='{"widget": "float", "decimal_precision": "2"}'/>
                                    </td>
                                    <td width="25%" style="text-align:right;">
                                        <span t-esc="amount + base" t-options='{"widget": "float", "decimal_precision": "2"}'/>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>

