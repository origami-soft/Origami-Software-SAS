<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <data>

        <record id="document_vat_diary_pdf" model="report.paperformat">
            <field name="name">A4 Horizontal</field>
            <field name="margin_top">35</field>
            <field name="orientation">Landscape</field>
            <field name="margin_bottom">10</field>
            <field name="margin_left">5</field>
            <field name="margin_right">5</field>
            <field name="header_spacing">30</field>
        </record>

        <record id="pdf_iva_diary_report_action" model="ir.actions.report">
            <field name="name">Subdiario IVA (PDF)</field>
            <field name="model">vat.diary</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_file">l10n_ar_vat_diary.pdf_vat_diary_report</field>
            <field name="report_name">l10n_ar_vat_diary.pdf_vat_diary_report</field>
            <field name="binding_model_id" ref="model_vat_diary"/>
            <field name="binding_type">report</field>
            <field name="paperformat_id" ref="document_vat_diary_pdf"/>
        </record>

    </data>
</odoo>

