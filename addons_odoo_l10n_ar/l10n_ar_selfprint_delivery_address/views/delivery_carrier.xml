<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <data>

        <record id="delivery_carrier_address_form_view" model="ir.ui.view">
            <field name="name">delivery_carrier_address_form_view</field>
            <field name="model">delivery.carrier</field>
            <field name="inherit_id" ref="delivery.view_delivery_carrier_form"/>
            <field name="arch" type="xml">
                <xpath expr="//group[@name='provider_details']" position="inside">
                        <field name="partner_id" widget="res_partner_many2one" context="{'show_address': 1}" options="{&quot;always_reload&quot;: True}"/>
                </xpath>
            </field>
        </record>

    </data>

</odoo>

