<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res_config_settings_view_form</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="website_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <block id="sale_product_catalog_settings" position="inside">
                <setting id="show_price_wo_tax_setting" string="Mostrar precio sin impuestos" help="Mostrar, debajo del precio normal, el precio sin impuestos nacionales">
                    <field name="show_price_wo_tax"/>
                </setting>
            </block>
        </field>
    </record>
</odoo>
