<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record model="ir.ui.view" id="tax_repartition_line_tree">
        <field name="name">Tax Repartition Line tree</field>
        <field name="model">account.tax.repartition.line</field>
        <field name="inherit_id" ref="account.tax_repartition_line_tree"/>
        <field name="arch" type="xml">
            <field name="account_id" position="before">
                <field name="amount_type" invisible="1"/>
            </field>
            <field name="account_id" position="attributes">
                <attribute name="required">amount_type == 'perception' and repartition_type == 'tax'</attribute>
            </field>
        </field>
    </record>

</odoo>

