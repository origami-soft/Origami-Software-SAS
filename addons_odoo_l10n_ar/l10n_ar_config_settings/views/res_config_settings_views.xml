<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <data>
        <record id="res_config_settings_view_form" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.l10n.ar.config.settings</field>
            <field name="model">res.config.settings</field>
            <field name="inherit_id" ref="base.res_config_settings_view_form" />
            <field name="arch" type="xml">
                <xpath expr="//form" position="inside">
                    <app data-string="Configuración Adicional" string="Configuración Adicional" name="extra_config" logo="/l10n_ar_config_settings/static/description/icon.png">
                        <h2>Reportes</h2>
                        <div class="row mt16 o_settings_container"
                            name="default_reports_settings_container">
                            <div class="col-12 col-lg-6 o_setting_box"
                                id="l10n_ar_stock_picking_report">
                                <div class="o_setting_left_pane">
                                    <field name="module_l10n_ar_stock_picking_report"
                                        widget="upgrade_boolean" />
                                </div>
                                <div class="o_setting_right_pane"
                                    name="l10n_ar_stock_picking_report_right_pane">
                                    <label for="module_l10n_ar_stock_picking_report"
                                        string="Autoimpresor" />
                                    <div class="text-muted">
                                        Remito autoimpresor.
                                    </div>
                                </div>
                            </div>
                            <div class="col-12 col-lg-6 o_setting_box"
                                id="l10n_ar_selfprint_delivery_address">
                                <div class="o_setting_left_pane">
                                    <field name="module_l10n_ar_selfprint_delivery_address"
                                        widget="upgrade_boolean" />
                                </div>
                                <div class="o_setting_right_pane"
                                    name="l10n_ar_selfprint_delivery_address">
                                    <label for="module_l10n_ar_selfprint_delivery_address"
                                        string="Transportista en remito" />
                                    <div class="text-muted">
                                        Transportista en remito.
                                    </div>
                                </div>
                            </div>
                            <div class="col-12 col-lg-6 o_setting_box"
                                id="l10n_ar_selfprint_merchandise_value">
                                <div class="o_setting_left_pane">
                                    <field name="module_l10n_ar_selfprint_merchandise_value"
                                        widget="upgrade_boolean" />
                                </div>
                                <div class="o_setting_right_pane"
                                    name="l10n_ar_selfprint_merchandise_value">
                                    <label for="module_l10n_ar_selfprint_merchandise_value"
                                        string="Remito valorizado" />
                                    <div class="text-muted">
                                        Remito valorizado.
                                    </div>
                                </div>
                            </div>
                            <div class="col-12 col-lg-6 o_setting_box"
                                id="l10n_ar_stock_picking_report">
                                <div class="o_setting_left_pane">
                                    <field
                                        name="module_l10n_ar_electronic_invoice_report_sale_stock"
                                        widget="upgrade_boolean" />
                                </div>
                                <div class="o_setting_right_pane"
                                    name="l10n_ar_electronic_invoice_report_sale_stock">
                                    <label for="module_l10n_ar_electronic_invoice_report_sale_stock"
                                        string="Lotes en facturas" />
                                    <div class="text-muted">
                                        Lotes en facturas.
                                    </div>
                                </div>
                            </div>
                        </div>
                        <h2>Modulos</h2>
                        <div class="row mt16 o_settings_container"
                            name="default_modules_settings_container">
                            <div class="col-12 col-lg-6 o_setting_box" id="l10n_ar_bank_reconcile">
                                <div class="o_setting_left_pane">
                                    <field name="module_l10n_ar_bank_reconcile"
                                        widget="upgrade_boolean" />
                                </div>
                                <div class="o_setting_right_pane"
                                    name="l10n_ar_bank_reconcile">
                                    <label for="module_l10n_ar_bank_reconcile"
                                        string="Conciliación Bancaria BO" />
                                    <div class="text-muted">
                                        Conciliacion bancaria realizado por Blueorange.
                                    </div>
                                </div>
                            </div>
                            <div class="col-12 col-lg-6 o_setting_box" id="l10n_credit_cards">
                                <div class="o_setting_left_pane">
                                    <field name="module_l10n_credit_cards"
                                        widget="upgrade_boolean" />
                                </div>
                                <div class="o_setting_right_pane"
                                    name="l10n_credit_cards">
                                    <label for="module_l10n_credit_cards"
                                        string="Conciliación Bancaria" />
                                    <div class="text-muted">
                                        Tarjeta de crédito
                                    </div>
                                </div>
                            </div>
                            <div class="col-12 col-lg-6 o_setting_box" id="account_financial_report">
                                <div class="o_setting_left_pane">
                                    <field name="module_account_financial_report"
                                        widget="upgrade_boolean" />
                                </div>
                                <div class="o_setting_right_pane"
                                    name="account_financial_report">
                                    <label for="module_account_financial_report"
                                        string="Comunidad en contabilidad" />
                                    <div class="text-muted">
                                        Comunidad para contabilidad
                                    </div>
                                </div>
                            </div>
                        </div>
                    </app>
                </xpath>
            </field>
        </record>

    </data>
</odoo>

