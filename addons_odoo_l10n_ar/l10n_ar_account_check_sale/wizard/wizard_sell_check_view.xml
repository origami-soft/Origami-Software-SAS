<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <record id="wizard_sell_check_form" model="ir.ui.view">
        <field name="name">Wizard.sell.check.form</field>
        <field name="model">wizard.sell.check</field>
        <field name="arch" type="xml">
            <form string="Vender cheques">
                <field name="display_error_mesage" invisible="1"/>
                <p invisible="not display_error_mesage" style="text-align: center">Los cheques seleccionados deben ser de la misma compañia.</p>
                <div name="check_sale" invisible="display_error_mesage">
                    <field name="company_id" invisible="1"/>
                    <field name="initial_amount" invisible="1"/>
                    <group string="Datos de la operación">
                        <group>
                            <field name="bank_account_id" invisible="partner_id" widget="selection"/>
                            <field name="partner_id" invisible="bank_account_id"/>
                        </group>
                        <group>
                            <field name="journal_id" invisible="not partner_id"
                                                     required="partner_id"/>
                            <field name="date"/>
                        </group>
                    </group>
                    <group string="Importes">
                        <group>
                            <field name="commission"/>
                            <field name="interests"/>
                            <field name="amount"/>
                        </group>
                        <group>
                            <field name="commission_account_id" required="commission"/>
                            <field name="interest_account_id" required="interests"/>
                        </group>
                    </group>
                    <footer>
                        <button name="create_sold_check_document" string="Vender" type="object" class="oe_highlight" invisible="display_error_mesage"/>
                        <button string="Cancelar" class="oe_link" special="cancel" invisiblee="display_error_mesage"/>
                        <button string="OK" class="oe_highlight" special="cancel" invisible="not display_error_mesage"/>
                    </footer>
                </div>
            </form>
        </field>
    </record>

    <!-- ACCIÓN  -->
    <record id="action_sell_checks" model="ir.actions.act_window">
        <field name="name">Vender cheques</field>
        <field name="res_model">wizard.sell.check</field>
        <field name="binding_model_id" ref="l10n_account_check.model_account_third_check"/>
        <field name="binding_view_types">list,form</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="wizard_sell_check_form"/>
    </record>

</odoo>

