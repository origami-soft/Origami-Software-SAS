<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <!-- VISTA TREE -->
    <record id="account_third_check_tree" model="ir.ui.view">
        <field name="name">account.third.check.tree</field>
        <field name="model">account.third.check</field>
        <field name="inherit_id" ref="l10n_account_check.account_third_check_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree" position="attributes">
                <attribute name="decoration-success">state in ['handed','deposited', 'sold']</attribute>
            </xpath>
        </field>
    </record>

    <record model="ir.ui.view" id="third_check_sold_check_form">
        <field name="name">Third.check.sold.check.form</field>
        <field name="model">account.third.check</field>
        <field name="inherit_id" ref="l10n_account_check.account_third_check_form"/>
        <field name="arch" type="xml">
            <field name="not_to_order" position="before">
                <field name="sold_check_id" invisible="not sold_check_id"/>
            </field>
            <field name="payment_date" position="after">
                <field name="sold_date" invisible="not sold_date"/>
                <field name="sold_bank_id" invisible="not sold_bank_id"/>
                <field name="sold_partner_id" invisible="not sold_partner_id"/>
            </field>
        </field>
    </record>

</odoo>

