<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <record model="ir.ui.view" id="retention_sicore_tree">
        <field name="name">retention_sicore_tree</field>
        <field name="model">retention.sicore</field>
        <field name="arch" type="xml">
            <tree default_order="date_from desc" editable="top">
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="file" filename="filename" widget="binary"/>
                <field name="filename" column_invisible="1"/>
                <button name="generate_file" type="object" string="Generar" icon="fa-file"/>
            </tree>
        </field>
    </record>

    <record model="ir.actions.act_window" id="retention_sicore_action">
        <field name="name">SICORE Retenciones</field>
        <field name="res_model">retention.sicore</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="retention_sicore_menu_view"
              name="SICORE Retenciones"
              parent="l10n_ar_bo.reports_ar_main_menu"
              action="retention_sicore_action"
              sequence="50"/>

</odoo>

