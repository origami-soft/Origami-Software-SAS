<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record model="ir.rule" id="perception_perception_multi">
            <field name="name">Perception perception: multi-company</field>
            <field name="model_id" ref="l10n_ar.model_perception_perception"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|',('company_id','in', company_ids),('company_id','=',False)]</field>
        </record>

        <record model="ir.rule" id="retention_retention_multi">
            <field name="name">Retention retention: multi-company</field>
            <field name="model_id" ref="l10n_ar.model_retention_retention"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|',('company_id','in', company_ids),('company_id','=',False)]</field>
        </record>

    </data>
</odoo>

