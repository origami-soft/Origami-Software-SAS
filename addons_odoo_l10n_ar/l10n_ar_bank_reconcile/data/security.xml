<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <data noupdate="1">

        <record model="ir.rule" id="account_bank_reconcile_multi">
            <field name="name">Account bank reconcile: multi-company</field>
            <field name="model_id" ref="model_account_bank_reconcile"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|',('company_id','=',False),('company_id', 'in', company_ids)]</field>
        </record>

        <record model="ir.rule" id="account_bank_reconcile_line_multi">
            <field name="name">Account bank reconcile line: multi-company</field>
            <field name="model_id" ref="model_account_bank_reconcile_line"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|',('company_id','=',False),('company_id', 'in', company_ids)]</field>
        </record>

        <record model="ir.rule" id="account_reconcile_move_line_multi">
            <field name="name">Account reconcile move line: multi-company</field>
            <field name="model_id" ref="model_account_reconcile_move_line"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|',('company_id','=',False),('company_id', 'in', company_ids)]</field>
        </record>

    </data>
</odoo>

