<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <data>

        <record id="account_reconcile_move_line_form_view" model="ir.ui.view">
            <field name="name">account.reconcile.move.line.form.view</field>
            <field name="model">account.reconcile.move.line</field>
            <field name="arch" type="xml">
                <form string="Movimientos">
                    <sheet>
                        <group>
                            <group>
                                <field name="name_move"/>
                                <field name="ref_move"/>
                                <field name="name_move_line"/>
                                <field name="currency_id"/>
                                <field name="move_line_id" invisible="1"/>
                            </group>
                            <group>
                                <field name="date_move_line"/>
                                <field name="debit_move_line"/>
                                <field name="credit_move_line"/>
                                <field name="amount_currency"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
    </data>

</odoo>

