<odoo>
    <data>

        <record model="ir.ui.view" id="bank_automatic_reconcile_wizard_form">
            <field name="name">Bank automatic reconcile wizard form</field>
            <field name="model">bank.automatic.reconcile.wizard</field>
            <field name="arch" type="xml">
                <form>
                    <group>
                        <group>
                            <field name="date_from"/>
                        </group>
                        <group>
                            <field name="date_to"/>
                            <field name="file" filename="filename"/>
                            <field name="filename" invisible="True"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Movimientos encontrados">
                            <field name="found_line_ids">
                                <tree create="false" edit="false">
                                    <field name="move_line_id" invisible="1"/>
                                    <field name="company_currency_id" invisible="1"/>
                                    <field name="move_line_date"/>
                                    <field name="move_line_name"/>
                                    <field name="move_line_ref"/>
                                    <field name="bank_description"/>
                                    <field name="move_line_partner_id"/>
                                    <field name="move_line_debit"/>
                                    <field name="move_line_credit"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Movimientos no encontrados del banco">
                            <field name="bank_line_ids" readonly="1">
                                <tree>
                                    <field name="date"/>
                                    <field name="name"/>
                                    <field name="debit"/>
                                    <field name="credit"/>
                                </tree>
                            </field>
                        </page>
                        <page string="Movimientos no encontrados del sistema">
                            <field name="not_found_line_ids">
                                <tree create="false" edit="false">
                                    <field name="move_line_id" invisible="1"/>
                                    <field name="company_currency_id" invisible="1"/>
                                    <field name="move_line_date"/>
                                    <field name="move_line_name"/>
                                    <field name="move_line_ref"/>
                                    <field name="move_line_partner_id"/>
                                    <field name="move_line_debit"/>
                                    <field name="move_line_credit"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                    <footer>
                        <button type="object"
                                name="concile_movements"
                                string="Conciliar movimientos encontrados"
                                class="btn-primary"/>
                        o
                        <button type="special"
                                special="cancel"
                                string="cancelar"
                                class="btn-default"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_bank_automatic_reconcile_view" model="ir.actions.act_window">
            <field name="name">Action bank automatic reconcile view</field>
            <field name="res_model">bank.automatic.reconcile.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>

        <act_window
            id="action_bank_automatic_reconcile_view"
            name="Conciliar con extracto"
            res_model="bank.automatic.reconcile.wizard"
            binding_model="account.bank.reconcile"
            binding_views="form"
            view_id="bank_automatic_reconcile_wizard_form"
            view_mode="form"
            target="new"
        />

    </data>
</odoo>

