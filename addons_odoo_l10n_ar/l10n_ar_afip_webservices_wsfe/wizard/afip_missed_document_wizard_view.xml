<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <data>

        <record model="ir.ui.view" id="afip_missed_document_wizard_form">
            <field name="name">Afip missed document wizard</field>
            <field name="model">afip.missed.document.wizard</field>
            <field name="arch" type="xml">
                <form>
                    <group col="2">
                        <field name="company_id" groups="base.group_multi_company"/>
                        <field name="company_id" invisible="True" groups="!base.group_multi_company"/>
                        <field name="pos_ar_id" domain="[('company_id', '=', company_id)]"/>
                        <field name="available_voucher_type_ids" invisible="1"/>
                        <field name="voucher_type_id" domain="[('id', 'in', available_voucher_type_ids)]"/>
                        <field name="document_number"/>
                    </group>
                    <notebook>
                        <page string="Respuesta" invisible="not response">
                            <field name="response" readonly="1"/>
                            <group string="Documento a asignar">
                                <field
                                    name="move_id"
                                    domain="[
                                        ('voucher_type_id', '=', voucher_type_id),
                                        ('pos_ar_id', '=', pos_ar_id),
                                        ('move_type', 'in', ['out_invoice', 'out_refund'])
                                   ]"
                                />
                            </group>
                        </page>
                    </notebook>
                    <footer>
                        <button
                            type="object"
                            name="fill_data"
                            invisible="not move_id or not response"
                            class="btn-primary"
                            string="Completar documento"
                        />
                        <button
                            type="object"
                            name="get_documents_data"
                            class="btn-primary"
                            string="Obtener datos"
                        />
                        <button special="cancel" string="Cancelar" class="btn-secondary" />
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_afip_missed_document_wizard_view" model="ir.actions.act_window">
            <field name="name">Recuperar comprobantes</field>
            <field name="res_model">afip.missed.document.wizard</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
        </record>
        
        <menuitem
            id="menu_afip_missed_document_wizard"
            name="Recuperar comprobantes"
            action="action_afip_missed_document_wizard_view"
            parent="l10n_point_of_sale.document_books_main_menu"
            sequence="20"
        />
            
    </data>
</odoo>

