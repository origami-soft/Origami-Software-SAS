<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <data>

        <record model="ir.ui.view" id="account_invoice_wsfe_form">
            <field name="name">Account invoice wsfe form</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">
                <field name="invoice_user_id" position="after">
                    <field name="cae" groups="!base.group_no_one" invisible="True"/>
                    <field name="is_credit_invoice" invisible="1"/>
                    <field name="date_service_from"
                          readonly="state != 'draft' or cae"/>
                    <field name="date_service_to"
                           readonly="'state' != 'draft' or cae"/>
                </field>
                <notebook position="inside">
                    <page string="Documentos asociados">
                        <field name="fce_associated_document_ids"
                               readonly="state != 'draft' or cae" nolabel="1">
                            <tree editable="bottom">
                                <field name="associated_invoice_id"/>
                                <field name="point_of_sale"/>
                                <field name="document_number"/>
                                <field name="document_code"/>
                                <field name="cuit_transmitter"/>
                                <field name="date"/>
                                <field name="canceled"/>
                            </tree>
                        </field>
                    </page>
                    <page string="Solicitudes AFIP"
                          invisible="document_book_type not in ['electronic', 'electronic_exportation', 'fiscal_electronic_bond']" groups="base.group_no_one">
                        <group>
                            <field
                                name="cae" groups="base.group_no_one"
                                invisible="document_book_type not in ['electronic', 'electronic_exportation', 'fiscal_electronic_bond']"
                            />
                            <field
                                name="cae" groups="!base.group_no_one"
                                invisible="True"
                            />
                            <field
                                name="cae_due_date"
                                invisible="document_book_type not in ['electronic', 'electronic_exportation', 'fiscal_electronic_bond']"
                            />
                        </group>
                        <field name="wsfe_request_detail_ids">
                            <tree>
                                <field name="date"/>
                                <field name="result"/>
                            </tree>
                        </field>
                    </page>
                    <page
                        string="FCE"
                        invisible="move_type != 'out_invoice' or is_debit_note or document_book_type not in ['electronic', 'fiscal_electronic_bond'] or not is_credit_invoice">
                        <group>
                            <field name="company_partner_id" invisible="1"/>
                            <field name="cbu_partner_bank_id" domain="[('partner_id', '=', company_partner_id)]"
                            readonly="state != 'draft' or cae"/>
                            <field
                                name="cbu_transmitter"
                                readonly="state != 'draft' or cae"
                                required="document_book_type in ['electronic', 'fiscal_electronic_bond'] and
                                is_credit_invoice and move_type == 'out_invoice' and
                                not is_debit_note"
                            />
                            <field
                                name="transfer_option"
                                readonly="state != 'draft' or cae"
                                required="document_book_type in ['electronic', 'fiscal_electronic_bond'] and
                                is_credit_invoice and move_type == 'out_invoice' and
                                not is_debit_note and state == 'draft'"
                            />
                            <field name="fce_rejected"/>
                        </group>
                    </page>
                </notebook>

            </field>
        </record>

    </data>
</odoo>

