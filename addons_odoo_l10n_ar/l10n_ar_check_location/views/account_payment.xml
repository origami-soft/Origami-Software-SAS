<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <record model="ir.ui.view" id="account_payment_location_check_form">
        <field name="name">account_payment_location_check_form</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="l10n_account_check.account_payment_checks_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='account_third_check_ids']//tree//field[@name='name']" position="after">
                <field name="check_location_id"/>
            </xpath>
            <xpath expr="//field[@name='account_own_check_ids']//tree//field[@name='name']" position="after">
                <field name="check_location_id"/>
            </xpath>
            <xpath expr="//field[@name='account_third_check_sent_ids']//tree//field[@name='name']" position="after">
                <field name="check_location_id"/>
            </xpath>
        </field>
    </record>

</odoo>

