<?xml version="1.0" encoding="utf-8"?>

<odoo>
        <record id="picking_paper_format" model="report.paperformat">
            <field name="name">Papel remito autoimpresor</field>
            <field name="margin_top">85</field>
            <field name="orientation">Portrait</field>
            <field name="margin_bottom">50</field>
            <field name="margin_left">5</field>
            <field name="margin_right">5</field>
            <field name="header_spacing">80</field>
        </record>

        <record id="action_selfprint_report" model="ir.actions.report">
            <field name="name">Remito autoimpresor</field>
            <field name="model">stock.picking</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">l10n_ar_stock_picking_report.report_selfprint_layout</field>
            <field name="report_file">l10n_ar_stock_picking_report.report_selfprint_layout</field>
            <field name="print_report_name">'REMITO {}'.format(object.name)</field>
            <field name="binding_model_id" ref="model_stock_picking"/>
            <field name="paperformat_id" ref="picking_paper_format"/>
            <field name="binding_type">report</field>
        </record>

</odoo>
    
