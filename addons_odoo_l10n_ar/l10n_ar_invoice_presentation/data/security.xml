<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <data noupdate="1">

        <record model="ir.rule" id="account_invoice_presentation_multi">
            <field name="name">Account invoice presentation: multi-company</field>
            <field name="model_id" ref="model_account_invoice_presentation"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|',('company_id','in', company_ids),('company_id','=',False)]</field>
        </record>

        <record model="ir.rule" id="account_invoice_vat_digital_book_multi">
            <field name="name">Account invoice vat digital book: multi-company</field>
            <field name="model_id" ref="model_account_invoice_vat_digital_book"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|',('company_id','in', company_ids),('company_id','=',False)]</field>
        </record>

    </data>
</odoo>

