<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <record model="ir.ui.view" id="account_move_supplier_importation_form">
        <field name="name">account_move_supplier_importation_form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <page name="other_info" position="after">
                <field name="voucher_type_importation" invisible="1"/>
                <page name="importation_forward" string="Carpeta de importación" invisible="move_type not in ['in_invoice', 'in_refund'] or not voucher_type_importation">
                    <group>
                        <group>
                            <field name="importation_partner_id" domain="[('supplier_rank', '>', 0)]"/>
                            <field name="importation_operation_type"/>
                        </group>
                        <group>
                            <field name="importation_djai"/>
                            <field name="importation_overdue_djai_date"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="importation_date"/>
                            <field name="importation_bl"/>
                        </group>
                        <group>
                            <field name="importation_etd"/>
                            <field name="importation_eta"/>
                        </group>
                    </group>
                </page>
            </page>
        </field>
    </record>

</odoo>

