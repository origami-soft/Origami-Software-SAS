<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="l10n_ar_afip_pos_invoicing.PartnerDetailsEdit" t-inherit="point_of_sale.PartnerDetailsEdit" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('partner-details-box')]" position="inside">
            <div class="partner-detail col">
                <label class="label form-label" for="fiscal_position">Posición fiscal</label>
                <select class="detail form-select" id="fiscal_position" name="property_account_position_id" t-model="changes.property_account_position_id" t-att="{'disabled': isFieldCommercialAndPartnerIsChild('property_account_position_id')}" t-att-class="{'border-danger': missingFields.includes('property_account_position_id')}">
                    <option value="">None</option>
                    <t t-foreach="pos.fiscal_positions" t-as="fiscal_position" t-key="fiscal_position.id">
                        <option t-att-value="fiscal_position.id">
                            <t t-esc="fiscal_position.name"/>
                        </option>
                    </t>
                </select>
            </div>
            <div class="partner-detail col">
                <label class="label form-label" for="document_type">Tipo de documento</label>
                <select class="detail form-select" id="document_type" name="partner_document_type_id" t-model="changes.partner_document_type_id" t-att="{'disabled': isFieldCommercialAndPartnerIsChild('partner_document_type_id')}" t-att-class="{'border-danger': missingFields.includes('partner_document_type_id')}">
                    <option value="">None</option>
                    <t t-foreach="pos.document_types" t-as="document_type" t-key="document_type.id">
                        <option t-att-value="document_type.id">
                            <t t-esc="document_type.name"/>
                        </option>
                    </t>
                </select>
            </div>
        </xpath>
    </t>
 </templates>
