<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!--RETENTIONS-->
        <template id="report_retentions_header">
            <div class="header">
                <div class="left">
                    <img t-if="o.company_id.logo"
                         t-att-src="image_data_uri(o.company_id.logo)"
                         style="max-height: 45px;"/>
                </div>
                <div style="float:right">
                    <strong>
                        <t t-if="r.retention_id.type == 'gross_income'">
                            Constancia de Retención IIBB
                        </t>
                        <t t-if="r.retention_id.type == 'vat'">
                            Constancia de Retención IVA
                        </t>
                        <t t-if="r.retention_id.type == 'profit'">
                            Constancia de Retención SICORE
                        </t>
                    </strong>
                    <br/><br/>
                    <div>
                        <t t-if="r.certificate_no">
                             Certificado N°: <span t-field="r.certificate_no"/>
                        </t>
                        <br/>
                        <t t-if="o.date">
                             Fecha: <span t-field="o.date"/>
                        </t>
                    </div>
                </div>
            </div>
        </template>
        <template id="report_retentions_footer">
            <div class="footer">
                <div style="width: 90%, text-center">
                    <t t-if="r.retention_id.type in ['profit', 'vat']">
                        Declaro que los datos consignados en este Formulario son correctos y completos y
                        que he confeccionado la presente utilizando mismo formato que la
                        AFIP sin falsear dato alguno que deba contener, siendo fiel expresión de la verdad.
                    </t>
                    <t t-if="r.retention_id.type == 'gross_income'">
                        La retención practicada mediante el presente certificado sera informada en la
                        declaración jurada correspondiente al periodo
                        <strong><span t-esc="o.date.strftime('%m/%Y')"/></strong>
                    </t>

                </div>
            </div>
        </template>
        <template id="report_retentions_layout">
            <t t-name="report.retentions_layout">
                <t t-call="web.html_container">
                    <t t-call="l10n_ar_account_payment_report.report_retentions_header"/>
                    <div class="article o_report_layout_standard" t-att-data-oe-model="o and o._name"
                         t-att-data-oe-id="o and o.id" t-att-data-oe-lang="o and o.env.context.get('lang')">
                        <t t-out="0"/>
                    </div>
                    <t t-call="l10n_ar_account_payment_report.report_retentions_footer"/>
                </t>
            </t>
        </template>
        <template id="report_retentions_body">
            <div class="page">
                <div style="width: 100%">
                    <div class="left">
                        <br/>
                        <h4>
                            <strong>A.- Datos del Agente de Retención</strong>
                        </h4>
                        <br/>
                        <strong>Apellido y Nombre o Denominación: </strong>
                        <span t-field="o.company_id.name"/>
                        <br/>
                        <strong>C.U.I.T N°: </strong>
                        <span t-field="o.company_id.vat"/>
                        <br/>
                        <strong>Domicilio: </strong>
                        <t t-if="o.company_id.street">
                            Direccion:
                            <span t-field="o.company_id.street"/>
                        </t>
                        <t t-if="o.company_id.city">
                            Ciudad:
                            <span t-field="o.company_id.city"/>
                        </t>
                        <br/><br/>
                        <h4>
                            <strong>B.- Datos del Sujeto Retenido</strong>
                        </h4>
                        <br/>
                        <strong>Apellido y Nombre o Denominación: </strong>
                        <span t-field="o.partner_id.name"/>
                        <br/>
                        <strong>C.U.I.T N°: </strong>
                        <span t-field="o.partner_id.vat"/>
                        <br/>
                        <strong>Domicilio: </strong>
                        <t t-if="o.partner_id.street">
                            Direccion:
                            <span t-field="o.partner_id.street"/>
                        </t>
                        <t t-if="o.partner_id.city">
                            Ciudad:
                            <span t-field="o.partner_id.city"/>
                        </t>
                        <br/><br/>
                        <h4>
                            <strong>C.- Datos de la Retención Practicada</strong>
                        </h4>
                        <br/>
                        <strong>Impuesto: </strong>
                        <span t-field="r.name"/>
                        <br/>
                        <t t-if="r.activity_id">
                            <strong>Regimen: </strong>
                            <span t-field="r.activity_id.name"/>
                            <br/>
                        </t>
                        <strong>Comprobante que origina la Retención: </strong>
                        <span t-field="o.full_voucher_name"/>
                        <br/>
                        <strong>Monto del Comprobante que origina la Retención: </strong>
                        <span t-field="o.amount"
                              t-options='{"widget": "monetary"}'
                        />
                        <br/>
                        <t t-if="r.retention_id.type in ['gross_income', 'profit', 'vat']">
                            <strong>Base de cálculo: </strong>
                            <span t-field="r.base"
                                  t-options="{'widget': 'monetary', 'display_currency': r.currency_id}"
                            />
                            <br/>
                        </t>
                        <strong>Monto de la Retención: </strong>
                        <span t-field="r.amount"
                              t-options="{'widget': 'monetary', 'display_currency': r.currency_id}"
                        />
                        <br/>
                        <strong>Imposibilidad de Retención:</strong>
                        <br/><br/>
                    </div>
                </div>
            </div>
        </template>
        <template id="report_retentions_template">
            <t t-call="l10n_ar_account_payment_report.report_retentions_layout">
                <t t-call="l10n_ar_account_payment_report.report_retentions_body"/>
            </t>
        </template>

        <template id="payment_receipt_document_layout">
        <div class="header">
            <t t-set="company" t-value="o.company_id"/>
            <div class="row">
                <img t-if="company.logo" class="text-left" style="max-height: 90px; max-width: 300px; width: auto" t-att-src="image_data_uri(company.logo)" alt="Logo"/>
                <div style="width:30px"></div>
                <div class="col-6" name="company_address">
                    <div t-field="company.partner_id"
                         t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": true}'
                         style="font-size: 10px; margin-bottom: -5px"
                    />
                    <span style="font-size: 10px" t-if="company.vat" class="list-inline-item d-inline"><t t-esc="company.country_id.vat_label or 'NIF'"/>: <span t-field="company.vat"/></span>
                </div>
            </div>
            <div t-if="company.logo or company.report_header" >
                <div class="col-12">
                    <div style="border-bottom: 1px solid black;"/>
                </div>
            </div>
        </div>

        <div t-attf-class="article o_report_layout_standard o_company_#{company.id}_layout" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id" t-att-data-oe-lang="o and o.env.context.get('lang')">
            <t t-out="0"/>
        </div>

        <div t-attf-class="footer o_standard_footer o_company_#{company.id}_layout">
            <div class="text-center" style="border-top: 1px solid black;">
                <div t-if="report_type == 'pdf'" class="text-muted">
                    Pagina: <span class="page"/> / <span class="topage"/>
                </div>
            </div>
        </div>
    </template>

        <template id="report_payment_receipt_document" inherit_id="account.report_payment_receipt_document">
            <t t-call="web.external_layout" position="attributes">
                <attribute name="t-call">l10n_ar_account_payment_report.payment_receipt_document_layout</attribute>
            </t>
            <div class="page" position="attributes">
                <attribute name="t-if">not(o.journal_id.payment_usage == 'document_book' or o.journal_id.pos_ar_id)</attribute>
            </div>
            <xpath expr="//div[@t-if='o.ref']/.." position="after">
                <div class="row" t-if="o.is_internal_transfer">
                    <div class="col-6">
                        Diario: <span t-field="o.journal_id.name"/>
                    </div>
                    <div class="col-6">
                        Diario destino: <span t-field="o.destination_journal_id.name"/>
                    </div>
                </div>
            </xpath>
            <div class="page" position="after">
                <div class="page" t-if="(o.journal_id.payment_usage == 'document_book' or o.journal_id.pos_ar_id)">
                    <h3 style="text-align: center">
                        <span t-if="o.payment_type == 'inbound'">RECIBO OFICIAL N° </span>
                        <span t-if="o.payment_type == 'outbound'">ORDEN DE PAGO N° </span>
                        <t t-if="o.voucher_name">
                            <span t-esc="o.voucher_name.upper()"/>
                        </t>
                        <t t-else="">
                            <span t-if="o.full_voucher_name" t-esc="o.full_voucher_name.upper()"/>
                            <span t-if="not o.full_voucher_name" t-esc="''"/>
                        </t>
                    </h3>
                    <div class="row">
                        <div class="col-5" t-if="o.partner_type">
                            <address t-field="o.partner_id" t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;], &quot;no_marker&quot;: True}"/>
                            <strong><span t-field="o.partner_id.partner_document_type_id"/>: </strong><span t-field="o.partner_id.vat"/>
                        </div>
                        <div class="col-6 offset-5" style="font-size 13px" t-if="o.date">
                            <strong>FECHA: </strong> <span t-field="o.date"/>
                        </div>
                    </div>
                    <div class="row mb64">
                        <div class="col" style="width:30%" t-if="o.amount">
                            <strong>IMPORTE: </strong><span t-field="o.amount" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                         </div>
                         <div class="col" style="width:70%; text-align: right" t-if="o.ref">
                            <p t-field="o.ref"/>
                        </div>
                    </div>

                     <!-- Tabla de documentos imputados -->
                     <t t-if="o.payment_imputation_ids or o.advance_amount">
                        <br/>
                        <h4>
                            <div class="text-center">
                                <strong>DOCUMENTOS IMPUTADOS</strong>
                            </div>
                        </h4>
                        <table class="table table-borderless">
                            <thead>
                                <tr style="border-top: 1px solid lightgray; border-collapse: collapse;">
                                    <th>DOCUMENTO IMPUTADO</th>
                                    <th>FECHA</th>
                                    <th class="text-end">IMPORTE ORIGINAL</th>
                                    <th class="text-end">RESTANTE</th>
                                    <th class="text-end">ASIGNACIÓN</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="o.payment_imputation_ids" t-as="i">
                                    <tr style="border-top: 0.5px groove lightgray; border-collapse: collapse;">
                                        <td>
                                            <span t-field="i.name"/>
                                        </td>
                                        <td class="text-center">
                                            <t t-if="i.move_line_id.move_id.invoice_date">
                                                <span t-field="i.move_line_id.move_id.invoice_date"/>
                                            </t>
                                            <t t-else="">
                                                <span t-field="i.move_line_date"/>
                                            </t>
                                        </td>
                                        <td class="text-end">
                                            <span t-esc="i.amount_total" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: i.currency_id}"/>
                                        </td>
                                        <td class="text-end">
                                            <span t-esc="i.amount_residual" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: i.currency_id}"/>
                                        </td>
                                        <td class="text-end">
                                            <span t-esc="i.amount" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>
                                        </td>
                                    </tr>
                                </t>
                                <t t-if="o.advance_amount">
                                    <tr>
                                        <td>
                                            SIN DOCUMENTO ASOCIADO
                                        </td>
                                        <td/>
                                        <td/>
                                        <td/>
                                        <td class="text-end">
                                            <span t-esc="o.advance_amount" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                        <div class="clearfix">
                            <div class="row">
                                <div t-attf-class="#{'col-4' if report_type != 'html' else 'col-sm-7 col-md-5'} ms-auto">
                                    <table class="table table-borderless">
                                        <tr class="border-black o_subtotal">
                                            <td><strong>TOTAL</strong></td>
                                            <td class="text-end">
                                                <t t-set="total_imputation" t-value="sum(i.amount for i in o.payment_imputation_ids) + o.advance_amount"/>
                                                <span t-esc="total_imputation" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>
                                            </td>
                                        </tr>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </t>

                    <!-- Detalles de formas de pago -->
                    <br/>

                    <t t-set="payment_line_recordsets" t-value="o._get_payment_line_recordsets()"/>
                    <t t-set="multi_currency" t-value="any(any(r.currency_id and r.currency_id != o.currency_id for r in rset) for rset in payment_line_recordsets)"/>
                    <h4>
                        <div class="text-center">
                            <strong>DETALLES DE FORMAS DE PAGO</strong>
                        </div>
                    </h4>
                    <table class="table table-borderless">
                        <thead>
                            <tr style="border-top: 1px solid lightgray; border-collapse: collapse;">
                                <th width="25%">MODO DE PAGO</th>
                                <th width="25%">FECHA</th>
                                <th width="25%">OBSERVACION</th>
                                <th width="25%" class="text-end">IMPORTE</th>
                                <t t-if="multi_currency">
                                    <th class="text-end">COTIZACIÓN</th>
                                    <th class="text-end">IMPORTE EN MONEDA DE PAGO</th>
                                </t>
                            </tr>
                        </thead>
                        <tbody>
                            <tr style="border-top: 0.5px groove lightgray; border-collapse: collapse;" t-foreach="payment_line_recordsets" t-as="payment_line_record">
                                <tr style="border-top: 0.5px groove lightgray; border-collapse: collapse;" t-foreach="payment_line_record" t-as="payment_line">
                                    <td width="25%">
                                        <span t-esc="payment_line.get_first_move_line_name().upper()"/>
                                    </td>
                                    <td width="25%" class="text-center">
                                        <span t-esc="payment_line.get_line_date()" t-options='{"widget": "date"}'/>
                                    </td>
                                    <td width="25%" class="text-center">
                                        <span t-esc="payment_line.get_line_observation()"/>
                                    </td>
                                    <td width="25%" class="text-end">
                                        <span t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: payment_line.currency_id}" t-field="payment_line.amount"/>
                                    </td>
                                    <t t-if="multi_currency">
                                        <td class="text-end">
                                            <span t-esc="payment_line.get_rate_field_value(o)" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: payment_line.currency_id}"/>
                                        </td>
                                        <td class="text-end">
                                            <span t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}" t-esc="payment_line.get_amount_field_value(o)"/>
                                        </td>
                                    </t>
                                </tr>
                            </tr>
                        </tbody>
                    </table>

                    <div class="clearfix">
                        <div class="row">
                            <div t-attf-class="#{'col-4' if report_type != 'html' else 'col-sm-7 col-md-5'} ms-auto">
                                <table class="table table-borderless">
                                    <tr class="border-black o_subtotal">
                                        <td><strong>TOTAL</strong></td>
                                        <td class="text-end">
                                            <span t-esc="o.get_payment_line_total()" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

        </template>

         <template id="report_retention_payment_call" inherit_id="account.report_payment_receipt">
             <t t-lang="lang" position="after">
                 <t t-if="o.payment_type == 'outbound'">
                     <t t-foreach="o.retention_ids" t-as="r">
                         <t t-call="l10n_ar_account_payment_report.report_retentions_template"/>
                     </t>
                 </t>
             </t>
         </template>

    </data>
</odoo>

