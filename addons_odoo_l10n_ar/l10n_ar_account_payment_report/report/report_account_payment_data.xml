<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <data>

        <record id="payment_receipt_paperformat" model="report.paperformat">
            <field name="name">Recibo A4</field>
            <field name="margin_top">34</field>
            <field name="orientation">Portrait</field>
            <field name="margin_bottom">15</field>
            <field name="margin_left">7</field>
            <field name="margin_right">7</field>
            <field name="header_spacing">30</field>
        </record>

        <record id="account.action_report_payment_receipt" model="ir.actions.report">
                <field name="paperformat_id" ref="payment_receipt_paperformat"/>
        </record>

    </data>
</odoo>

