<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <record model="ir.ui.view" id="res_config_settings_view_form">
        <field name="name">res.config.settings.view.form.inherit.payment.report</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <block id="invoicing_settings" position="after">
                <h2>Impresion de Recibos de Cliente</h2>
                <div class="row mt16 o_settings_container" id="customer_receipt_print_settings">
                    <div class="col-12 col-lg-6 o_setting_box">
                        <div class="o_setting_right_pane">
                            <label for="customer_receipt_print_option"/>
                            <div class="text-muted mb8">
                                Seleccione que solapa se imprimira en los recibos de cliente (PDF).
                            </div>
                            <field name="customer_receipt_print_option" widget="radio"/>
                            <div class="mt16" invisible="not customer_receipt_print_option_last_update">
                                <span class="text-muted">Ultima modificacion: </span>
                                <field name="customer_receipt_print_option_last_update" widget="datetime" class="d-inline"/>
                                <span class="text-muted"> por </span>
                                <field name="customer_receipt_print_option_last_user_id" widget="many2one" class="d-inline" options="{'no_open': True}"/>
                            </div>
                        </div>
                    </div>
                </div>
            </block>
        </field>
    </record>

</odoo>

