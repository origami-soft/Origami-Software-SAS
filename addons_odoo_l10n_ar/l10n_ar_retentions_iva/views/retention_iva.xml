<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <data>

        <!-- FORM VIEW -->
        <record model="ir.ui.view" id="retention_iva_form">
            <field name="name">retention.iva.form</field>
            <field name="model">retention.iva</field>
            <field name="arch" type="xml">
                <form string="Iva Retenciones">
                    <sheet>
                        <group>
                            <field name="name" />
                            <field name="company_id" groups="base.group_multi_company" />
                            <field name="retention_code" />
                            <field name="date_from" />
                            <field name="date_to" />
                            <field name="file" filename="filename" />
                            <field name="filename" invisible="True" />
                            <button name="generate_file"
                                type="object"
                                string="Generar"
                                icon="fa-gear"
                                colspan="1"
                            />
                        </group>
                    </sheet>
                </form>
            </field>
        </record>


        <!-- TREE VIEW -->
        <record model="ir.ui.view" id="retention_iva_tree">
            <field name="name">retention.iva.tree</field>
            <field name="model">retention.iva</field>
            <field name="arch" type="xml">
                <tree string="Iva Retenciones" default_order="date_from desc">
                    <field name="name" />
                    <field name="company_id" groups="base.group_multi_company" />
                    <field name="retention_code" />
                    <field name="date_from" />
                    <field name="date_to" />
                    <field name="file" filename="filename" />
                    <field name="filename" invisible="True" />
                </tree>
            </field>
        </record>

        <!-- ACTION -->
        <record model="ir.actions.act_window" id="retention_iva_action">
            <field name="name">IVA Retenciones</field>
            <field name="res_model">retention.iva</field>
            <field name="view_mode">tree,form</field>
        </record>

        <!-- MENU -->
        <menuitem id="retention_iva_menu_view" name="IVA Retenciones"
            parent="l10n_ar_bo.reports_ar_main_menu" action="retention_iva_action" sequence="41" />

    </data>

</odoo>

