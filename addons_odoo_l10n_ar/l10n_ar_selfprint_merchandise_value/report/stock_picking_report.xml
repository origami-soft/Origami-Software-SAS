<odoo>

    <template id="report_stock_picking" inherit_id="l10n_ar_selfprint_delivery_address.report_selfprint_body">
        <xpath expr="//div[@t-if='o.carrier_id.partner_id']" position="after">
            <div t-if="o.carrier_id.show_insurance_value" style="border-bottom:1px solid black;!important;padding: 5px 0px 5px 20px">
                <b>Valor asegurado:</b><br/>
                $ <span t-field="o.insurance_value"/>
            </div>
        </xpath>
    </template>

</odoo>

