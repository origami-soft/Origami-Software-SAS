<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <record model="ir.ui.view" id="view_delivery_carrier_form">
        <field name="name">view_delivery_carrier_form</field>
        <field name="model">delivery.carrier</field>
        <field name="inherit_id" ref="delivery.view_delivery_carrier_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='company_id']" position="after">
                <field name="show_insurance_value"/>
                <field name="coefficient_value" invisible="not show_insurance_value"/>
            </xpath>
        </field>
    </record>

    <record model="ir.ui.view" id="view_picking_form">
        <field name="name">view_picking_form</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='backorder_id']" position="after">
                <field name="insurance_value" readonly="state == 'done'" invisible="picking_type_code != 'outgoing'"/>
                <field name="insurance_value_in_currency" readonly="state == 'done'" invisible="insurance_value == insurance_value_in_currency"/>
            </xpath>
        </field>
    </record>
</odoo>

