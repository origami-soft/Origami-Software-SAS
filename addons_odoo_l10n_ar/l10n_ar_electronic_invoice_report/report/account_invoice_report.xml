<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <data noupdate="0">

        <record id="electronic_invoice_paper_format" model="report.paperformat">
            <field name="name">Papel factura electronica</field>
            <field name="margin_top">90</field>
            <field name="orientation">Portrait</field>
            <field name="margin_bottom">55</field>
            <field name="margin_left">5</field>
            <field name="margin_right">5</field>
            <field name="header_spacing">85</field>
        </record>

        <record id="action_electronic_invoice" model="ir.actions.report">
            <field name="name">Factura electrónica</field>
            <field name="model">account.move</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">l10n_ar_electronic_invoice_report.electronic_invoice</field>
            <field name="report_file">l10n_ar_electronic_invoice_report.electronic_invoice</field>
            <field name="print_report_name">object.full_voucher_name</field>
            <field name="binding_model_id" ref="model_account_move"/>
            <field name="paperformat_id" ref="electronic_invoice_paper_format"/>
            <field name="binding_type">report</field>
        </record>

    </data>

</odoo>

