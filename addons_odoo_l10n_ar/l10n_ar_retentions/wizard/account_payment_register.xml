<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <record model="ir.ui.view" id="view_account_payment_register_form">
        <field name="name">view_account_payment_register_form</field>
        <field name="model">account.payment.register</field>
        <field name="inherit_id" ref="l10n_payment_line.view_account_payment_register_form"/>
        <field name="priority">19</field>
        <field name="arch" type="xml">
            <notebook position="inside">
                <page name="retentions" string="Retenciones">
                        <field name="retention_ids" nolabel="1">
                            <tree editable="bottom" string="Retenciones">
                                <field name="company_id" column_invisible="1"/>
                                <field name="type" column_invisible="1"/>
                                <field name="payment_id" column_invisible="1"/>
                                <field name="payment_currency_id" column_invisible="1"/>
                                <field name="same_currency_as_payment" column_invisible="1"/>
                                <field name="currency_id" column_invisible="1"/>
                                <field name="journal_id"/>
                                <field name="retention_id" domain="['|', ('type_tax_use', '=', parent.payment_type == 'outbound' and 'purchase'), ('type_tax_use', '=', parent.payment_type == 'inbound' and 'sale'), '|', ('company_id', '=', False), ('company_id', '=', parent.company_id)]"/>
                                <field name="certificate_no"/>
                                <field name="date" required="parent.partner_type != 'supplier'"/>
                                <field name="activity_id"
                                       required="parent.payment_type == 'outbound' and type == 'profit'"
                                       invisible="type not in ['profit', 'vat']"
                                />
                                <field name="rate"/>
                                <field name="aliquot"/>
                                <field name="base" sum="Total"/>
                                <field name="amount" sum="Total"/>
                                <field name="payment_currency_amount" sum="Total"/>
                                <field name="name" column_invisible="1"/>
                                <field name="jurisdiction" column_invisible="1"/>
                            </tree>
                        </field>
                    </page>
            </notebook>
        </field>
    </record>

</odoo>

