<odoo>

    <record model="ir.ui.view" id="third_check_reject_move_form">
        <field name="name">Third check reject move form</field>
        <field name="model">account.third.check</field>
        <field name="inherit_id" ref="l10n_reject_checks.third_check_reject_form"/>
        <field name="arch" type="xml">
            <field name="company_id" position="after">
                <field name="reject_move_id" attrs="{'invisible': [('reject_move_id', '=', False)]}"/>
            </field>
            <button name="button_reject_check" position="attributes">
                <attribute name="invisible">1</attribute>
            </button>
            <button name="button_revert_reject" position="attributes">
                <attribute name="confirm">Si el cheque tiene asiento de rechazo, deberá anularlo manualmente.</attribute>
            </button>
            <header position="inside">
                <button name="get_reject_check_wizard" string="Rechazar" type="object"
                        attrs="{'invisible': [('state', '=', 'rejected')]}"
                        groups="l10n_account_check.group_account_treasury_manager"
                        context="{'default_check_state': state}"
                />
            </header>
        </field>
    </record>

</odoo>

