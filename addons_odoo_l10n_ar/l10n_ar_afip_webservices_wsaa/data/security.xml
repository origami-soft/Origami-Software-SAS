<?xml version="1.0" encoding="utf-8"?>

<odoo>
    <data noupdate="1">

        <record model="ir.rule" id="wsaa_configuration_multi">
            <field name="name">Wsaa configuration: multi-company</field>
            <field name="model_id" ref="model_wsaa_configuration"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|',('company_id','in', company_ids),('company_id','=',False)]</field>
        </record>

        <record model="ir.rule" id="wsaa_token_multi">
            <field name="name">Wsaa token: multi-company</field>
            <field name="model_id" ref="model_wsaa_token"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|',('company_id','in', company_ids),('company_id','=',False)]</field>
        </record>

    </data>
</odoo>

