<?xml version="1.0" encoding="utf-8"?>
<odoo>
    
    <!-- View res.config.settings form -->
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.l10n.ar.restrict.state</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='extra_config']" position="inside">
                <h2>Facturas</h2>
                    <div class="row mt16 o_settings_container"
                        name="default_draft_invoice_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box" id="restrict_draft_invoices">
                            <div class="o_setting_left_pane">
                                <field name="restrict_draft_invoices"
                                    widget="upgrade_boolean" />
                            </div>
                            <div class="o_setting_right_pane"
                                name="restrict_draft_invoices">
                                <label for="restrict_draft_invoices"
                                    string="Restringir estado borrador" />
                                <div class="text-muted">
                                    Evitar que puedan ser devueltas a borrador las facturas publicadas con CAE
                                </div>
                            </div>
                        </div>
                        
                    </div>
            </xpath>
        </field>
    </record>

</odoo>

