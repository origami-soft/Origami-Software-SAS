<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <record model="ir.ui.view" id="sale_subscription_order_view_form">
        <field name="name">sale_subscription_order_view_form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_subscription.sale_subscription_order_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='order_line']/tree//field[@name='price_unit']" position="attributes">
                <attribute name="readonly">qty_invoiced &gt; 0 and not parent.is_subscription</attribute>
            </xpath>
        </field>
    </record>

</odoo>

