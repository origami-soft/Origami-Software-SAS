<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!--HEADER-->
        <template id="report_document_tax_header">
            <div class="header">
                <table class="table-borderless" style="text-align: left">
                    <tr><td><b><span t-field="o.company_id.name"/></b></td></tr>
                    <tr><td><span t-esc="o.company_id.street"/> - <span t-esc="o.company_id.city"/> - <span t-esc="o.company_id.state_id.name"/> (<span t-esc="o.company_id.zip"/>)</td></tr>
                    <tr><td>C.U.I.T: <span t-field="o.company_id.vat"/></td></tr>
                </table>
            </div>
        </template>

        <!--LAYOUT-->
        <template id="report_document_tax_layout">
            <t t-name="report.document_tax_layout">
                <t t-call="l10n_ar_perceptions_retentions_pdf.report_document_tax_header"/>
                    <div class="article o_report_layout_standard" t-att-data-oe-model="o and o._name"
                         t-att-data-oe-id="o and o.id" t-att-data-oe-lang="o and o.env.context.get('lang')">
                        <t t-raw="0"/>
                    </div>
            </t>
        </template>

        <template id="report_document_tax_body">
            <div class="page">
                <t t-set="total" t-value="0"/>
                <t t-set="base" t-value="0"/>
                 <div style="text-align: center; margin-bottom: 10px; font-size: 18px">
                     <b><span t-esc="o.get_report_document_tax_name()"/></b>
                 </div>
                 <table class="table-borderless" style="font-size: 11px; width: 100%">
                    <thead style="font-size: 13px">
                        <tr style="border-top: 1px solid;border-bottom: 1px solid">
                            <th class="text-start">FECHA</th>
                            <th class="text-start">COMPROBANTE</th>
                            <th class="text-start">RAZÓN SOCIAL</th>
                            <th class="text-start">C.U.I.T.</th>
                            <th class="text-start">ORIGEN</th>
                            <th class="text-end">MONTO ORIGEN</th>
                            <th class="text-end">BASE IMPONIBLE</th>
                            <th class="text-end">ALICUOTA (%)</th>
                            <th class="text-end">IMPORTE</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="o.get_report_document_tax_data()" t-as="line">
                            <t t-set="total" t-value="total+line.get('amount')"/>
                            <t t-set="base" t-value="base+line.get('taxable_base')"/>
                            <tr>
                                <td class="text-start"><t t-esc="line.get('date')" t-options='{"widget": "date"}'/></td>
                                <td class="text-start"><t t-esc="line.get('name')"/></td>
                                <td class="text-start"><t t-esc="line.get('partner')"/></td>
                                <td class="text-start"><t t-esc="line.get('document_number')"/></td>
                                <td class="text-start"><t t-esc="line.get('origin')"/></td>
                                <td class="text-end"><t t-esc="line.get('origin_amount')" t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/></td>
                                <td class="text-end"><t t-esc="line.get('taxable_base')" t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/></td>
                                <td class="text-end"><t t-esc="line.get('aliquot')"/></td>
                                <td class="text-end"><t t-esc="line.get('amount')" t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/></td>
                            </tr>
                        </t>
                        <tr style="border-top: 1px solid; border-bottom: 1px solid">
                            <td class="text-start" colspan="5"><b>TOTAL</b></td>
                            <td class="text-end" colspan="2"><t t-esc="base" t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/></td>
                            <td/>
                            <td class="text-end"><t t-esc="total" t-options='{"widget": "monetary", "display_currency": o.company_id.currency_id}'/></td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </template>

        <template id="report_document_tax_template">
            <t t-call="l10n_ar_perceptions_retentions_pdf.report_document_tax_layout">
                <t t-call="l10n_ar_perceptions_retentions_pdf.report_document_tax_body"/>
            </t>
        </template>

        <template id="report_document_tax">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="l10n_ar_perceptions_retentions_pdf.report_document_tax_template"/>
                </t>
            </t>
        </template>

    </data>
</odoo>

